{% comment %}
  Full page. A transit extension gets {{ transit }} rather than {{ source_1 }}:
  the provider has already normalised whatever the operator's API returned.
{% endcomment %}

<div class="screen">
  <div class="title-bar">
    <div class="title">{{ transit.origin }}{% if transit.destination %} &rarr; {{ transit.destination }}{% endif %}</div>
    <div class="meta">{{ transit.provider | upcase }}</div>
  </div>

  <div class="content">
    {% if transit.empty %}
      <div class="layout layout--col layout--center">
        <p class="t-lg t-bold">No departures</p>
        <p class="t-sm">Nothing scheduled from here right now.</p>
      </div>
    {% else %}
      <div class="list">
        {% for departure in transit.departures %}
          <div class="list-item">
            <span class="primary truncate">
              <span class="t-bold">{{ departure.line }}</span>
              {{ departure.direction }}
              {% if departure.platform %}<span class="t-sm">plat {{ departure.platform }}</span>{% endif %}
            </span>
            <span class="secondary t-mono t-bold">
              {% if departure.cancelled %}
                CANC
              {% else %}
                {{ departure.expected }}{% if departure.delayed %}<span class="t-sm">+{{ departure.delay }}</span>{% endif %}
              {% endif %}
            </span>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% if transit.alerts.size > 0 %}
    <div class="footer-bar">
      <span class="truncate">{{ transit.alerts[0].title }}</span>
      <span class="badge">alert</span>
    </div>
  {% endif %}
</div>
