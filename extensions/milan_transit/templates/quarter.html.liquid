{% comment %} Quarter: 400x240. The next train, and the one after it. {% endcomment %}

<div class="screen">
  {% if transit.empty %}
    <div class="content layout layout--col layout--center">
      <p class="t-bold">No departures</p>
    </div>
  {% else %}
    {% assign next = transit.departures[0] %}
    <div class="content layout layout--col" style="justify-content: space-between">
      <div class="kv">
        <span class="k t-xs">{{ transit.origin | truncate: 16 }}</span>
        <span class="v t-xs">{{ next.line }}</span>
      </div>

      <div class="stat">
        <span class="value t-mono">{% if next.cancelled %}CANC{% else %}{{ next.expected }}{% endif %}</span>
        <span class="label truncate">{{ next.direction }}</span>
      </div>

      {% if transit.departures.size > 1 %}
        {% assign following = transit.departures[1] %}
        <div class="kv t-sm">
          <span class="k truncate">then {{ following.line }}</span>
          <span class="v t-mono t-bold">{{ following.expected }}</span>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
