{% comment %} Half width: 400x480. Line and time on one row, direction beneath. {% endcomment %}

<div class="screen">
  <div class="title-bar">
    <div class="title">{{ transit.origin | truncate: 18 }}</div>
  </div>

  <div class="content content--tight">
    {% if transit.empty %}
      <div class="layout layout--col layout--center">
        <p class="t-bold">No departures</p>
      </div>
    {% else %}
      <div class="list">
        {% for departure in transit.departures limit: 5 %}
          <div class="stack stack--tight" style="padding: 8px 0">
            <div class="kv">
              <span class="k t-bold">{{ departure.line }}</span>
              <span class="v t-mono t-bold">
                {% if departure.cancelled %}CANC{% else %}{{ departure.expected }}{% if departure.delayed %}<span class="t-sm">+{{ departure.delay }}</span>{% endif %}{% endif %}
              </span>
            </div>
            <div class="t-sm clamp-2">{{ departure.direction }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
