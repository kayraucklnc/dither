{% comment %} Quarter: 400x240. Only what is next fits legibly. {% endcomment %}

{% assign next = calendar.next %}

<div class="screen dense">
  {% if calendar.empty or next == nil %}
    <div class="content layout layout--col layout--center" style="gap: 6px">
      <span class="i i-calendar-check i-md"></span>
      <p class="t-sm t-bold">Nothing next</p>
    </div>
  {% else %}
    <div class="content layout layout--col" style="justify-content: space-between">
      <div class="kv">
        <span class="k t-xs t-upper">{{ extension.values.heading | default: "Next" }}</span>
        <span class="v t-xs t-mono t-bold">{{ next.start }}</span>
      </div>

      <div class="stack stack--tight" style="gap: 4px">
        <p class="t-lg t-bold clamp-2">{{ next.title }}</p>
        <p class="with-icon t-sm">
          <span class="i i-clock i-xs"></span>{{ next.minutes_until | in_words }}
          {% if extension.values.show_location and next.location != blank %}
            <span class="i i-{% if next.remote %}video{% else %}pin{% endif %} i-xs"
                  style="margin-left: 6px"></span>
            <span class="truncate">{{ next.location }}</span>
          {% endif %}
        </p>
      </div>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
