{% comment %} Third width: 267x480. The day as a narrow agenda. {% endcomment %}

<div class="screen dense">
  <div class="title-bar" style="padding: 14px 14px 8px">
    <div class="title" style="font-size: 18px">{{ extension.values.heading | default: calendar.range_label }}</div>
  </div>

  {% if calendar.empty or calendar.next == nil %}
    <div class="content layout layout--col layout--center" style="gap: 6px">
      <span class="i i-calendar-check i-md"></span>
      <p class="t-xs t-bold">Nothing</p>
      <p class="t-xs t-upper t-center clamp-2">{{ calendar.range_label }}</p>
    </div>
  {% else %}
    <div class="content content--tight">
      <div class="timeline">
        {% for event in calendar.events limit: 6 %}
          <div class="entry" style="grid-template-columns: 46px 12px 1fr; gap: 0 8px">
            <span class="at" style="font-size: 13px">{{ event.start }}</span>
            <span class="spine"><span class="node{% if forloop.first %} node--now{% endif %}"></span></span>
            <span class="body">
              <span class="what clamp-2" style="display: block; font-size: 13px">{{ event.title }}</span>
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
