{% comment %} Third width: 267x480. A narrow full-height column beside something else. {% endcomment %}

<div class="screen">
  <div class="content content--tight layout layout--col">
    <p class="t-xs t-upper muted">{{ extension.values.heading | default: "Today" }}</p>

    {% if calendar.empty or calendar.next == nil %}
      <p class="t-sm t-bold" style="margin-top: 12px">Nothing scheduled</p>
    {% else %}
      {% for event in calendar.events limit: 5 %}
        <div class="stack stack--tight" style="padding: 10px 0">
          <p class="t-xs t-mono">{{ event.start }}</p>
          <p class="t-sm t-bold clamp-2">{{ event.title }}</p>
        </div>
        {% unless forloop.last %}<div class="rule"></div>{% endunless %}
      {% endfor %}
    {% endif %}
  </div>
</div>
