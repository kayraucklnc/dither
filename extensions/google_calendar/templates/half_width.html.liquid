{% comment %} Half width: 400x480. The day as a single timeline. {% endcomment %}

{% assign next = calendar.next %}

<div class="screen">
  <div class="title-bar">
    <div class="title">{{ extension.values.heading | default: "Today" }}</div>
    <div class="t-sm t-bold">{{ calendar.remaining_today | default: 0 }}</div>
  </div>

  {% if calendar.empty or next == nil %}
    <div class="content layout layout--col layout--center" style="gap: 8px">
      <span class="i i-calendar-check i-lg"></span>
      <p class="t-md t-bold">Nothing scheduled</p>
    </div>
  {% else %}
    <div class="content content--tight layout layout--col">
      <div class="box" style="margin-bottom: 12px; padding: 12px">
        <p class="t-xs t-upper">{{ next.minutes_until | in_words }}</p>
        <p class="t-lg t-bold clamp-2" style="margin-top: 4px">{{ next.title }}</p>
        <p class="t-sm t-mono">{{ next.start }} &ndash; {{ next.end }}</p>
      </div>

      <div class="timeline fit">
        {% for event in calendar.events offset: 1 limit: 4 %}
          <div class="entry">
            <span class="at">{{ event.start }}</span>
            <span class="spine"><span class="node"></span></span>
            <span class="body">
              <span class="what truncate" style="display: block">{{ event.title }}</span>
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
