{% comment %}
  The week - seven days, how full each one is, and what starts it.

  The only design here that is not about today. It answers the question a wall
  calendar is for: which day this week is the bad one. Each column is a bar of
  how much of that day is spoken for, so a glance reads the week's shape rather
  than its contents.

  Scaled against the fullest day rather than against a notional eight-hour one,
  because a week where nothing exceeds three hours drawn against eight is seven
  stubs that say nothing. The busiest day's figure is printed, so the scale is
  never a mystery.
{% endcomment %}

{%- assign day = calendar -%}
{%- assign hh = "now" | date: "%H" | times: 60 -%}
{%- assign now_mins = "now" | date: "%M" | plus: hh -%}

{%- assign box_w = shape.width | at_least: 320 -%}
{%- assign box_h = shape.height | at_least: 100 -%}
{%- assign pad = box_w | divided_by: 30 | at_least: 10 | at_most: 20 -%}

{%- comment %} The tallest bar is the busiest day, with a floor so that a quiet
  week is not drawn as a busy one. {% endcomment -%}
{%- assign peak = 120 -%}
{%- for entry in day.days -%}
  {%- if entry.busy_minutes > peak %}{% assign peak = entry.busy_minutes %}{% endif -%}
{%- endfor -%}

{%- assign header = 40 -%}
{%- if notices.size > 0 %}{% assign header = header | plus: 34 %}{% endif -%}
{%- comment %} Divided by the days there are, not by seven: a payload with
  fewer is drawn at the width it has rather than at a seventh each. Floored at
  one, because a payload with no days at all must not divide by nothing. {% endcomment -%}
{%- assign columns = day.days.size | at_least: 1 -%}
{%- assign column_w = box_w | minus: pad | minus: pad | divided_by: columns -%}
{%- assign named = false -%}
{%- if column_w > 62 %}{% assign named = true %}{% endif -%}

<div class="screen{% if box_h < 200 %} dense{% endif %}">
  <div class="title-bar" style="padding: {{ pad }}px {{ pad }}px 8px">
    <div class="title" style="font-size: {{ box_w | divided_by: 26 | at_least: 15 | at_most: 28 }}px">
      {{ extension.values.heading | default: "The week" }}
    </div>
    <div class="t-xs t-bold">busiest {{ peak | span_in_words }}</div>
  </div>

  {%- comment %} Seven columns of one day is not a week, it is one bar stretched
    across the panel - and stretched it reads as a day that is completely full.
    The fetch decides how many days there are, so a window of "the rest of
    today" gives this design nothing to draw and the honest answer is to say
    which setting to change rather than to draw a convincing lie. {% endcomment -%}
  {% if day.days.size < 3 %}
    <div class="content layout layout--col layout--center" style="gap: 6px; padding: {{ pad }}px">
      <span class="i i-calendar {% if box_h > 200 %}i-lg{% else %}i-md{% endif %}"></span>
      <p class="t-sm t-bold t-center">A week needs more than {% if day.days.size == 1 %}one day{% else %}two days{% endif %}</p>
      {% if box_h > 150 %}
        <p class="t-xs t-center">Set &ldquo;Show&rdquo; to the rest of this week.</p>
      {% endif %}
    </div>
  {% else %}
  <div class="content" style="padding: {{ pad }}px">
    <div class="bars" style="gap: {{ column_w | divided_by: 8 | at_least: 3 | at_most: 10 }}px">
      {% for entry in day.days %}
        {%- assign height = entry.busy_minutes | times: 100 | divided_by: peak -%}
        <div class="bar">
          {% if entry.count > 0 and box_h > 150 %}
            <span class="tick t-bold">{{ entry.count }}</span>
          {% endif %}

          {%- comment %} A day with nothing on it is an outlined box rather than
            no box, or an empty Saturday reads as missing data. {% endcomment -%}
          <span class="fill{% if entry.busy_minutes == 0 %} fill--empty{% elsif entry.is_weekend %} fill--hatch{% endif %}"
                style="height: {{ height | at_least: 3 }}%"></span>

          <span class="tick t-bold" style="{% if entry.is_today %}text-decoration: underline{% endif %}">
            {% if named %}{{ entry.day }}{% else %}{{ entry.day | slice: 0, 1 }}{% endif %}
          </span>
          {% if box_h > 190 %}
            <span class="tick" style="font-size: 10px">
              {% if entry.first != blank %}{{ entry.first }}{% else %}&mdash;{% endif %}
            </span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if notices.size > 0 %}
    <div class="notice-strip" style="padding: 5px {{ pad }}px">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}
      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
