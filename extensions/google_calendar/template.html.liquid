{% comment %}
  Full: 800x480. What is next, large, with the rest of the day as a timeline
  beside it. The timeline earns its place here: seeing the gaps is most of
  what you want from a day's calendar.
{% endcomment %}

{% assign next = calendar.next %}
{% assign style = extension.values.style | default: "rich" %}

<div class="screen">
  <div class="title-bar">
    <div class="title">{{ extension.values.heading | default: calendar.range_label }}</div>
    <div class="chip">
      <span class="i i-calendar"></span>
      {{ calendar.remaining_today | default: 0 }} left
    </div>
  </div>

  {% if calendar.empty or next == nil %}
    {% comment %}
      An all-day entry has no start time, so it is not on the timeline - but
      "Nothing scheduled" on the day you are on annual leave is the wrong
      answer, and this is the one design with room to say so.
    {% endcomment %}
    <div class="content layout layout--col layout--center" style="gap: 10px">
      <span class="i i-calendar-check i-xl"></span>
      {% if calendar.all_day_today > 0 %}
        {% for entry in calendar.all_day limit: 2 %}
          {% if entry.today %}
            <p class="t-xl t-bold clamp-2">{{ entry.title }}</p>
          {% endif %}
        {% endfor %}
        <p class="t-sm">All day. Nothing else scheduled.</p>
      {% else %}
        <p class="t-xl t-bold">{{ calendar.empty_label | default: "Nothing scheduled" }}</p>
        <p class="t-sm">Nothing on the calendars you picked.</p>
      {% endif %}
    </div>
  {% else %}
    <div class="content">
      <div class="split-detail">
        <div class="stack fit" style="justify-content: center; gap: 10px">
          <span class="chip self-start">
            <span class="i i-clock"></span>
            {{ next.minutes_until | in_words }}
          </span>

          <p class="t-bold clamp-2" style="font-size: 42px; line-height: 1.05">{{ next.title }}</p>

          <p class="t-lg t-mono t-bold">{{ next.start }} &ndash; {{ next.end }}</p>

          {% if extension.values.show_location and next.location != blank %}
            <p class="with-icon t-md">
              <span class="i i-{% if next.remote %}video{% else %}pin{% endif %} i-sm"></span>
              <span class="clamp-2">{{ next.location }}</span>
            </p>
          {% endif %}
        </div>

        <div class="fit" style="overflow: hidden">
          <div class="timeline">
            {% for event in calendar.events limit: 5 %}
              <div class="entry">
                <span class="at">{{ event.start }}</span>
                <span class="spine">
                  <span class="node{% if forloop.first %} node--now{% endif %}"></span>
                </span>
                <span class="body">
                  <span class="what truncate" style="display: block">{{ event.title }}</span>
                  {% if calendar.many and event.calendar != blank %}
                    <span class="where">
                      <span class="i i-calendar i-xs"></span>
                      <span class="truncate">{{ event.calendar }}</span>
                    </span>
                  {% endif %}
                  {% if extension.values.show_location and event.location != blank %}
                    <span class="where">
                      <span class="i i-{% if event.remote %}video{% else %}pin{% endif %} i-xs"></span>
                      <span class="truncate">{{ event.location }}</span>
                    </span>
                  {% endif %}
                </span>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
