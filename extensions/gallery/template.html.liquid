{% comment %}
  Wallpaper - the picture and nothing else.

  The design the whole extension exists for, and the one with the least in it.
  A panel painted once and left on a wall for a quarter of an hour is a print,
  not a screen, and the right thing to do with a print is hang it and get out
  of the way.

  So the crop is asked for at the exact pixel size of the box, which is what
  `as_image` is for: no CSS scaling, no letterbox, no guessing which third of a
  portrait photograph mattered. Everything else here is optional and off by
  default - a caption on a wallpaper is a screenshot.
{% endcomment %}

{%- assign shot = source_1.picture -%}
{%- assign fit = extension.values.fit | default: "fill" -%}
{%- assign focus = extension.values.focus | default: "auto" -%}
{%- assign contrast = extension.values.contrast | default: 0 -%}
{%- assign brightness = extension.values.brightness | default: 0 -%}
{%- assign screen = extension.values.screen | default: "panel" -%}
{%- assign marks = extension.values.marks | default: 4 -%}
{%- assign invert = extension.values.invert -%}

{%- assign plate = shot.id
      | as_image: width: shape.width, height: shape.height,
                  fit: fit, focus: focus, contrast: contrast,
                  brightness: brightness, screen: screen, marks: marks, invert: invert -%}

{%- assign pad = shape.width | at_most: shape.height | divided_by: 16 | at_least: 8 | at_most: 20 -%}

{% if plate == "" %}
{%- comment %} Nothing to hang.

  On a panel this is the state that matters most, because the alternative to
  drawing it well is a white rectangle - and a white rectangle is exactly what
  a broken server looks like from across a room. So it draws the mark a missing
  picture has always been drawn with, and says where to put one.
{% endcomment -%}
{%- assign short = shape.width | at_most: shape.height | at_least: 40 -%}
{%- assign mark = short | divided_by: 3 | at_least: 20 | at_most: 88 -%}
{%- assign pad = short | divided_by: 10 | at_least: 6 | at_most: 22 -%}

<div class="screen" style="align-items: center; justify-content: center; text-align: center;
                           gap: {{ pad }}px; padding: {{ pad }}px">
  <div style="flex: none; width: {{ mark | times: 1.5 | round }}px; height: {{ mark }}px;
              border: 3px solid var(--ink);
              background: linear-gradient(to top right, var(--paper) calc(50% - 2px),
                          var(--ink) calc(50% - 2px), var(--ink) calc(50% + 2px),
                          var(--paper) calc(50% + 2px))"></div>

  {% if short > 110 %}
    <p class="t-bold t-upper" style="flex: none; font-size: {{ short | divided_by: 14 | at_least: 11 | at_most: 17 }}px; letter-spacing: 0.08em">
      No pictures yet
    </p>
  {% endif %}
  {% if short > 190 %}
    <p class="t-xs" style="flex: none; max-width: 82%">
      Put some in your gallery folder - see docs/gallery.md
    </p>
  {% endif %}
</div>
{% else %}
<div class="screen" style="position: relative">
  <img src="{{ plate }}" alt=""
       style="position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover">

  <div style="position: relative; display: flex; flex-direction: column; height: 100%">
    {% if extension.values.caption and shot.title != blank %}
      {%- comment %} Solid, because whatever is behind it could be any tone at
        all, and type over a photograph on one bit is either backed or gone. {% endcomment -%}
      <span style="margin-top: auto; align-self: flex-start; max-width: 70%;
                   background: var(--ink); color: var(--paper);
                   font-size: {{ shape.height | divided_by: 34 | at_least: 10 | at_most: 15 }}px;
                   font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
                   padding: 4px 9px; margin-left: {{ pad }}px; margin-bottom: {{ pad }}px;
                   overflow: hidden; text-overflow: ellipsis; white-space: nowrap">
        {{ shot.title }}
      </span>
    {% endif %}

    {% if notices.size > 0 %}
      <div class="notice-strip" style="margin-top: auto; background: var(--paper); padding: 6px {{ pad }}px">
        {% for notice in notices %}
          {% if notice.overflow %}
            <span class="notice notice--more">+{{ notice.overflow }}</span>
          {% else %}
            <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
              <span class="i i-{{ notice.icon }}"></span>
            </span>
          {% endif %}
        {% endfor %}
        {% if shape.wide and notices[0].text != blank %}
          <span class="notice-said">{{ notices[0].text }}</span>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
{% endif %}
