{% comment %}
  Strip - a shallow full-width crop.

  Two rows on this grid is eighty pixels, which is not enough for a picture to
  be about anything - so this is not a small wallpaper, it is a *slice*. The
  crop is asked for at 12x2 or 12x4 and `as_image` picks the most detailed
  band it can find at that shape, which is why a strip out of a landscape
  usually lands on the horizon.

  Nothing is drawn over it but a caption, and only where there is room for one
  to sit beside rather than on the picture.
{% endcomment %}

{%- assign shot = source_1.picture -%}
{%- assign fit = extension.values.fit | default: "fill" -%}
{%- assign focus = extension.values.focus | default: "auto" -%}
{%- assign contrast = extension.values.contrast | default: 0 -%}
{%- assign brightness = extension.values.brightness | default: 0 -%}
{%- assign screen = extension.values.screen | default: "panel" -%}
{%- assign marks = extension.values.marks | default: 4 -%}
{%- assign invert = extension.values.invert -%}

{%- assign captioned = false -%}
{%- assign label_w = 0 -%}
{%- if extension.values.caption and shot.title != blank and shape.columns > 7 -%}
  {%- assign captioned = true -%}
  {%- assign label_w = shape.width | times: 26 | divided_by: 100 | at_least: 90 | at_most: 200 -%}
{%- endif -%}

{%- assign plate_w = shape.width | minus: label_w | at_least: 40 -%}
{%- assign plate = shot.id
      | as_image: width: plate_w, height: shape.height,
                  fit: fit, focus: focus, contrast: contrast,
                  brightness: brightness, screen: screen, marks: marks, invert: invert -%}

{% if plate == "" %}
{%- comment %} Nothing to hang.

  On a panel this is the state that matters most, because the alternative to
  drawing it well is a white rectangle - and a white rectangle is exactly what
  a broken server looks like from across a room. So it draws the mark a missing
  picture has always been drawn with, and says where to put one.
{% endcomment -%}
{%- assign short = shape.width | at_most: shape.height | at_least: 40 -%}
{%- assign mark = short | divided_by: 3 | at_least: 20 | at_most: 88 -%}
{%- assign pad = short | divided_by: 10 | at_least: 6 | at_most: 22 -%}

<div class="screen" style="align-items: center; justify-content: center; text-align: center;
                           gap: {{ pad }}px; padding: {{ pad }}px">
  <div style="flex: none; width: {{ mark | times: 1.5 | round }}px; height: {{ mark }}px;
              border: 3px solid var(--ink);
              background: linear-gradient(to top right, var(--paper) calc(50% - 2px),
                          var(--ink) calc(50% - 2px), var(--ink) calc(50% + 2px),
                          var(--paper) calc(50% + 2px))"></div>

  {% if short > 110 %}
    <p class="t-bold t-upper" style="flex: none; font-size: {{ short | divided_by: 14 | at_least: 11 | at_most: 17 }}px; letter-spacing: 0.08em">
      No pictures yet
    </p>
  {% endif %}
  {% if short > 190 %}
    <p class="t-xs" style="flex: none; max-width: 82%">
      Put some in your gallery folder - see docs/gallery.md
    </p>
  {% endif %}
</div>
{% else %}
<div class="screen" style="flex-direction: row">
  {% if captioned %}
    {%- comment %} Inverted and to the side, so it is legible without being
      over anything. Ink is free on this display and it is the only emphasis
      there is. {% endcomment -%}
    <div style="flex: none; width: {{ label_w }}px; background: var(--ink); color: var(--paper);
                display: flex; flex-direction: column; justify-content: center;
                gap: 3px; padding: 0 {{ shape.height | divided_by: 5 | at_least: 8 | at_most: 16 }}px">
      <p class="t-bold truncate" style="font-size: {{ shape.height | divided_by: 3.4 | at_least: 12 | at_most: 22 }}px">
        {{ shot.title }}
      </p>
      {% if shape.rows > 2 %}
        <p class="truncate" style="font-size: {{ shape.height | divided_by: 6 | at_least: 9 | at_most: 13 }}px; letter-spacing: 0.06em; text-transform: uppercase">
          {{ source_1.collection_label }}
        </p>
      {% endif %}
    </div>
  {% endif %}

  <div style="flex: 1 1 auto; min-width: 0; position: relative">
    <img src="{{ plate }}" alt=""
         style="position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover">

    {% if notices.size > 0 %}
      <div style="position: absolute; right: 0; top: 0; bottom: 0; display: flex; align-items: center;
                  gap: 5px; padding: 0 8px; background: var(--paper); border-left: var(--rule) solid var(--ink)">
        {% for notice in notices %}
          {% if notice.overflow %}
            <span class="notice notice--more">+{{ notice.overflow }}</span>
          {% else %}
            <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
              <span class="i i-{{ notice.icon }}"></span>
            </span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
{% endif %}
