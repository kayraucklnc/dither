{% comment %}
  Print - the picture matted, ruled and captioned.

  The other honest thing to do with a display that behaves like paper: stop
  pretending the panel is a window and treat it as a sheet with something
  mounted on it. The mat is a real margin of paper, the rule is a real frame,
  and the caption sits under the plate where a caption goes.

  The mat is taken from the *shorter* side. A twelfth of the width either side
  of a 12x4 band is eighty pixels of an eighty-pixel box - the trap that eats a
  band whole - so anything measuring a margin here measures the short way.
{% endcomment %}

{%- assign shot = source_1.picture -%}
{%- assign fit = extension.values.fit | default: "fill" -%}
{%- assign focus = extension.values.focus | default: "auto" -%}
{%- assign contrast = extension.values.contrast | default: 0 -%}
{%- assign brightness = extension.values.brightness | default: 0 -%}
{%- assign screen = extension.values.screen | default: "panel" -%}
{%- assign marks = extension.values.marks | default: 4 -%}
{%- assign invert = extension.values.invert -%}

{%- assign short = shape.width | at_most: shape.height | at_least: 80 -%}
{%- assign mat = short | divided_by: 11 | at_least: 9 | at_most: 30 -%}
{%- assign rule = 2 -%}
{%- if short > 260 %}{% assign rule = 3 %}{% endif -%}

{%- assign captioned = false -%}
{%- assign caption_h = 0 -%}
{%- if extension.values.caption and short > 110 -%}
  {%- assign captioned = true -%}
  {%- assign caption_h = short | divided_by: 7 | at_least: 22 | at_most: 44 -%}
{%- endif -%}

{%- assign notice_h = 0 -%}
{%- if notices.size > 0 %}{% assign notice_h = 30 %}{% endif -%}

{%- comment %} The plate is asked for at the exact pixels it will occupy, and
  the arithmetic has to include the gap under it - a chosen screen comes back
  already black and white, and a black-and-white image placed at 99% of its own
  size is resampled back into greys for the page dither to find. {% endcomment -%}
{%- assign gap = mat | divided_by: 2 | at_least: 5 -%}
{%- assign under = notice_h -%}
{%- if captioned %}{% assign under = under | plus: caption_h | plus: gap %}{% endif -%}

{%- assign plate_w = shape.width | minus: mat | minus: mat | minus: rule | minus: rule | at_least: 24 -%}
{%- assign plate_h = shape.height | minus: mat | minus: mat | minus: rule | minus: rule
      | minus: under | at_least: 24 -%}

{%- assign plate = shot.id
      | as_image: width: plate_w, height: plate_h,
                  fit: fit, focus: focus, contrast: contrast,
                  brightness: brightness, screen: screen, marks: marks, invert: invert -%}

{%- assign title_size = caption_h | times: 45 | divided_by: 100 | at_least: 11 | at_most: 20 -%}

{% if plate == "" %}
{%- comment %} Nothing to hang.

  On a panel this is the state that matters most, because the alternative to
  drawing it well is a white rectangle - and a white rectangle is exactly what
  a broken server looks like from across a room. So it draws the mark a missing
  picture has always been drawn with, and says where to put one.
{% endcomment -%}
{%- assign short = shape.width | at_most: shape.height | at_least: 40 -%}
{%- assign mark = short | divided_by: 3 | at_least: 20 | at_most: 88 -%}
{%- assign pad = short | divided_by: 10 | at_least: 6 | at_most: 22 -%}

<div class="screen" style="align-items: center; justify-content: center; text-align: center;
                           gap: {{ pad }}px; padding: {{ pad }}px">
  <div style="flex: none; width: {{ mark | times: 1.5 | round }}px; height: {{ mark }}px;
              border: 3px solid var(--ink);
              background: linear-gradient(to top right, var(--paper) calc(50% - 2px),
                          var(--ink) calc(50% - 2px), var(--ink) calc(50% + 2px),
                          var(--paper) calc(50% + 2px))"></div>

  {% if short > 110 %}
    <p class="t-bold t-upper" style="flex: none; font-size: {{ short | divided_by: 14 | at_least: 11 | at_most: 17 }}px; letter-spacing: 0.08em">
      No pictures yet
    </p>
  {% endif %}
  {% if short > 190 %}
    <p class="t-xs" style="flex: none; max-width: 82%">
      Put some in your gallery folder - see docs/gallery.md
    </p>
  {% endif %}
</div>
{% else %}
<div class="screen">
  <div class="content layout layout--col" style="padding: {{ mat }}px; gap: {{ gap }}px">
    <div style="flex: 1 1 auto; min-height: 0; border: {{ rule }}px solid var(--ink); background: var(--paper)">
      <img src="{{ plate }}" alt="" width="{{ plate_w }}" height="{{ plate_h }}"
           style="display: block; width: 100%; height: 100%; object-fit: cover">
    </div>

    {% if captioned %}
      {%- comment %} Title on the left, where it is read; the plate number on
        the right, where it is looked up. Both on one line and both truncated -
        a caption that wraps pushes the plate out of a box with overflow
        hidden, which reads as a rendering bug rather than as too many words. {% endcomment -%}
      <div style="flex: none; display: flex; align-items: baseline; gap: 10px; min-width: 0">
        <p class="t-bold truncate" style="font-size: {{ title_size }}px; flex: 1 1 auto; min-width: 0">
          {{ shot.title | default: source_1.collection_label }}
        </p>
        {% if shape.columns > 5 %}
          <p class="t-mono truncate" style="flex: none; font-size: {{ title_size | times: 68 | divided_by: 100 | at_least: 9 }}px">
            {{ source_1.position }}/{{ source_1.count }}
          </p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if notices.size > 0 %}
    <div class="notice-strip" style="padding: 5px {{ mat }}px">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}
      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
{% endif %}
