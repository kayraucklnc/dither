{% comment %} Third height: 800x160. One band, read at a glance from anywhere. {% endcomment %}

{% assign now = source_1.current %}
{% assign today = source_1.daily %}

<div class="screen">
  {% if now %}
    <div class="content layout layout--row" style="align-items: center; gap: 24px">
      <div class="with-icon" style="gap: 14px">
        <span class="i i-{{ now.weather_code | weather_icon }} i-lg"></span>
        <div>
          <p class="t-bold" style="font-size: 46px; line-height: 1">{{ now.temperature_2m | round }}&deg;</p>
          <p class="t-xs t-upper">{{ extension.values.place | default: "Weather" }}</p>
        </div>
      </div>

      <div class="fit" style="border-left: var(--rule) solid var(--ink); padding-left: 24px">
        <p class="t-md t-bold">{{ now.weather_code | weather_label }}</p>
        <p class="t-sm">Feels like {{ now.apparent_temperature | round }}&deg;</p>
      </div>

      <div class="facts" style="min-width: 250px">
        <div class="row">
          <span class="name"><span class="i i-thermometer i-xs"></span>High / low</span>
          <span class="figure">
            {{ today.temperature_2m_max[0] | round }}&deg; / {{ today.temperature_2m_min[0] | round }}&deg;
          </span>
        </div>
        <div class="row">
          <span class="name"><span class="i i-umbrella i-xs"></span>Rain</span>
          <span class="figure">{{ today.precipitation_probability_max[0] }}%</span>
        </div>
        {% comment %} Only room for these in a band taller than two rows. {% endcomment %}
        {% if shape.rows > 4 %}
          <div class="row">
            <span class="name"><span class="i i-wind i-xs"></span>Wind</span>
            <span class="figure">
              {{ now.wind_speed_10m | round }} km/h {{ now.wind_direction_10m | compass }}
            </span>
          </div>
          <div class="row">
            <span class="name"><span class="i i-sunrise i-xs"></span>Sun</span>
            <span class="figure">
              {{ today.sunrise[0] | clock_of }}&ndash;{{ today.sunset[0] | clock_of }}
            </span>
          </div>
        {% endif %}
      </div>
    </div>

    {% if shape.rows > 6 and source_1.hourly %}
      <div style="border-top: var(--rule) solid var(--ink); flex: 1; min-height: 0; padding: 10px var(--pad) 8px">
        <div class="bars">
          {% for at in source_1.hourly.time limit: 12 %}
            {% assign chance = source_1.hourly.precipitation_probability[forloop.index0] %}
            <div class="bar">
              <span class="tick t-bold">{{ source_1.hourly.temperature_2m[forloop.index0] | round }}&deg;</span>
              <span class="fill{% if chance < 5 %} fill--empty{% endif %}"
                    style="height: {{ chance | as_percent: 100 | at_least: 3 }}%"></span>
              <span class="tick">{{ at | hour_of }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="content layout layout--row layout--center">
      <span class="i i-cloud i-md"></span>
      <p class="t-md t-bold">No forecast</p>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
