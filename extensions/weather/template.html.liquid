{% comment %}
  Full: 800x480. The number you read from the sofa, the detail you read up
  close, and the hours ahead along the bottom.
{% endcomment %}

{% assign now = source_1.current %}
{% assign today = source_1.daily %}
{% assign hours = extension.values.show_hours | default: 12 %}
{% assign compact = false %}
{% if extension.values.style == "compact" %}{% assign compact = true %}{% endif %}

<div class="screen">
  {% if now %}
    <div class="title-bar">
      <div class="title">{{ extension.values.place | default: "Weather" }}</div>
      <div class="chip">
        <span class="i i-{{ now.weather_code | weather_icon }}"></span>
        {{ now.weather_code | weather_short }}
      </div>
    </div>

    <div class="content">
      <div class="split-detail">
        <div class="hero fit">
          <span class="i i-{{ now.weather_code | weather_icon }}" style="font-size: 104px"></span>
          <p class="t-bold" style="font-size: 76px; line-height: 1">{{ now.temperature_2m | round }}&deg;</p>
          <p class="caption">Feels like {{ now.apparent_temperature | round }}&deg;</p>
        </div>

        <div class="stack stack--tight fit" style="justify-content: center">
          <div class="facts">
            <div class="row">
              <span class="name"><span class="i i-arrow-up i-xs"></span>High</span>
              <span class="figure">{{ today.temperature_2m_max[0] | round }}&deg;</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-arrow-down i-xs"></span>Low</span>
              <span class="figure">{{ today.temperature_2m_min[0] | round }}&deg;</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-umbrella i-xs"></span>Rain</span>
              <span class="figure">{{ today.precipitation_probability_max[0] }}%</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-wind i-xs"></span>Wind</span>
              <span class="figure">
                {{ now.wind_speed_10m | round }} km/h {{ now.wind_direction_10m | compass }}
              </span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-droplet i-xs"></span>Humidity</span>
              <span class="figure">{{ now.relative_humidity_2m }}%</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-sunrise i-xs"></span>Sun</span>
              <span class="figure">
                {{ today.sunrise[0] | clock_of }}&ndash;{{ today.sunset[0] | clock_of }}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {% if hours > 0 and compact == false and source_1.hourly %}
      <div style="border-top: var(--rule) solid var(--ink); height: 116px; padding: 10px var(--pad) 8px">
        <div class="bars">
          {% for at in source_1.hourly.time limit: hours %}
            {% assign chance = source_1.hourly.precipitation_probability[forloop.index0] %}
            <div class="bar">
              <span class="tick t-bold">{{ source_1.hourly.temperature_2m[forloop.index0] | round }}&deg;</span>
              <span class="fill{% if chance < 5 %} fill--empty{% endif %}"
                    style="height: {{ chance | as_percent: 100 | at_least: 3 }}%"></span>
              <span class="tick">{{ at | hour_of }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% else %}
    <div class="content layout layout--col layout--center">
      <span class="i i-cloud i-xl"></span>
      <p class="t-lg t-bold">No forecast yet</p>
      <p class="t-sm">Check the coordinates in this widget's settings.</p>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
