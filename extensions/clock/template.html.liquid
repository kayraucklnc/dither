{% comment %}
  Full: 800x480. Three styles from one template, because they share their
  arithmetic and differ only in what they draw.
{% endcomment %}

{% comment %}
  Dates already render in the installation time zone, so no offset is needed
  for the common case. A value here means "this clock is somewhere else", and
  shifts relative to the installation rather than from UTC.
{% endcomment %}
{% assign shift = 0 %}
{% if extension.values.utc_offset_hours != blank %}
  {% assign shift = extension.values.utc_offset_hours | times: 3600 | minus: dither.offset_seconds %}
{% endif %}
{% assign stamp = "now" | date: "%s" | plus: shift %}
{% assign style = extension.values.style | default: "digital" %}
{% if extension.values.twenty_four_hour == false %}
  {% assign face = stamp | date: "%I:%M" %}
  {% assign suffix = stamp | date: "%p" %}
{% else %}
  {% assign face = stamp | date: "%H:%M" %}
  {% assign suffix = "" %}
{% endif %}

<div class="screen">
  {% if style == "analogue" %}
    {% assign minutes = stamp | date: "%M" | times: 1 %}
    {% assign hours = stamp | date: "%H" | times: 1 | modulo: 12 %}
    {% assign minute_angle = minutes | times: 6 %}
    {% assign hour_angle = hours | times: 30 | plus: minutes | divided_by: 2 %}

    <div class="content layout layout--row layout--center" style="gap: 48px">
      <svg viewBox="0 0 200 200" width="360" height="360" fill="none" stroke="black">
        <circle cx="100" cy="100" r="95" stroke-width="5"/>
        {% for tick in (0..11) %}
          {% assign angle = tick | times: 30 %}
          <line x1="100" y1="14" x2="100" y2="{% if tick == 0 or tick == 3 or tick == 6 or tick == 9 %}30{% else %}23{% endif %}"
                stroke-width="{% if tick == 0 or tick == 3 or tick == 6 or tick == 9 %}7{% else %}3{% endif %}"
                stroke-linecap="round"
                transform="rotate({{ angle }} 100 100)"/>
        {% endfor %}
        <line x1="100" y1="100" x2="100" y2="48" stroke-width="9" stroke-linecap="round"
              transform="rotate({{ hour_angle }} 100 100)"/>
        <line x1="100" y1="100" x2="100" y2="26" stroke-width="5" stroke-linecap="round"
              transform="rotate({{ minute_angle }} 100 100)"/>
        <circle cx="100" cy="100" r="8" fill="black" stroke="none"/>
      </svg>

      <div class="stack stack--tight">
        {% if extension.values.heading != blank %}
          <p class="t-sm t-upper">{{ extension.values.heading }}</p>
        {% endif %}
        <p class="t-bold" style="font-size: 64px; line-height: 1">{{ face }}{{ suffix | downcase }}</p>
        <p class="t-md">{{ stamp | date: "%A" }}</p>
        <p class="t-sm">{{ stamp | date: "%-d %B %Y" }}</p>
      </div>
    </div>

  {% elsif style == "dated" %}
    <div class="content split-detail">
      <div class="hero fit">
        {% if extension.values.heading != blank %}
          <p class="caption">{{ extension.values.heading }}</p>
        {% endif %}
        <p class="t-mono t-bold" style="font-size: 132px; line-height: 1">{{ face }}</p>
        {% if suffix != "" %}<p class="caption">{{ suffix }}</p>{% endif %}
      </div>

      <div class="hero fit">
        <p class="t-bold" style="font-size: 108px; line-height: 1">{{ stamp | date: "%-d" }}</p>
        <p class="t-lg t-bold">{{ stamp | date: "%B" }}</p>
        <p class="caption">{{ stamp | date: "%A" }}</p>
      </div>
    </div>

  {% else %}
    <div class="content layout layout--col layout--center" style="gap: 10px">
      {% if extension.values.heading != blank %}
        <p class="t-md t-upper">{{ extension.values.heading }}</p>
      {% endif %}
      <p class="t-mono t-bold" style="font-size: 190px; line-height: 0.92; letter-spacing: -0.04em">
        {{ face }}
      </p>
      <p class="t-lg">{{ stamp | date: "%A %-d %B" }}{% if suffix != "" %} &middot; {{ suffix }}{% endif %}</p>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
