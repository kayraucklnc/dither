{% comment %} Third height: 800x160. A band with the time on one side. {% endcomment %}

{% comment %}
  Dates already render in the installation time zone, so no offset is needed
  for the common case. A value here means "this clock is somewhere else", and
  shifts relative to the installation rather than from UTC.
{% endcomment %}
{% assign shift = 0 %}
{% if extension.values.utc_offset_hours != blank %}
  {% assign shift = extension.values.utc_offset_hours | times: 3600 | minus: dither.offset_seconds %}
{% endif %}
{% assign stamp = "now" | date: "%s" | plus: shift %}
{% if extension.values.twenty_four_hour == false %}
  {% assign face = stamp | date: "%I:%M %p" %}
{% else %}
  {% assign face = stamp | date: "%H:%M" %}
{% endif %}

<div class="screen">
  <div class="content layout layout--row" style="align-items: center; gap: 28px">
    <p class="t-mono t-bold" style="font-size: 82px; line-height: 1; letter-spacing: -0.03em">
      {{ face }}
    </p>

    <div class="fit" style="border-left: var(--rule) solid var(--ink); padding-left: 28px">
      <p class="t-lg t-bold">{{ stamp | date: "%A" }}</p>
      <p class="t-md">{{ stamp | date: "%-d %B %Y" }}</p>
    </div>

    {% if extension.values.heading != blank %}
      <span class="chip self-start">{{ extension.values.heading }}</span>
    {% endif %}
  </div>

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
