{% comment %} Third height: 800x160. A strip, so time and date sit side by side. {% endcomment %}

{% assign shift = extension.values.utc_offset_hours | times: 3600 %}
{% assign stamp = "now" | date: "%s" | plus: shift %}

<div class="screen">
  <div class="content content--tight layout layout--row layout--center" style="justify-content: space-between">
    <span class="t-mono t-bold" style="font-size: 64px; line-height: 1">
      {{ stamp | date: "%H:%M" }}
    </span>
    <span class="t-lg">{{ stamp | date: "%A, %-d %B" }}</span>
  </div>
</div>
