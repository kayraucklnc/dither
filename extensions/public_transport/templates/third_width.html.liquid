{% comment %} Third width: 267x480. A narrow board beside something wider. {% endcomment %}

{% assign board = transit %}

<div class="screen dense">
  <div class="title-bar" style="padding: 14px 14px 8px">
    <div class="title truncate" style="font-size: 17px">{{ board.origin | truncate: 14 }}</div>
  </div>

  {% if board.empty %}
    <div class="content layout layout--col layout--center" style="gap: 6px">
      <span class="i i-train i-md"></span>
      <p class="t-xs t-bold">None</p>
    </div>
  {% else %}
    <div class="content content--tight">
      <div class="list">
        {% for train in board.departures limit: 6 %}
          <div class="list-item" style="padding: 8px 0">
            <span style="min-width: 0">
              <span class="t-sm t-bold" style="display: block">{{ train.line }}</span>
              <span class="t-xs truncate" style="display: block">{{ train.direction }}</span>
            </span>
            <span class="t-mono t-bold t-sm">
              {% if train.cancelled %}—{% else %}{{ train.expected }}{% endif %}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% comment %} Where another extension gets to say something on this screen. {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        <span class="notice{% if notice.loud %} notice--loud{% endif %}">
          <span class="i i-{{ notice.icon }}"></span>{{ notice.text }}
        </span>
      {% endfor %}
    </div>
  {% endif %}
</div>
