{% comment %} Quarter: 400x240. The next train, and the one after it. {% endcomment %}

{% assign board = transit %}
{% assign next = board.departures[0] %}

<div class="screen dense">
  {% if board.empty or next == nil %}
    <div class="content layout layout--col layout--center" style="gap: 6px">
      <span class="i i-train i-md"></span>
      <p class="t-sm t-bold">No departures</p>
    </div>
  {% else %}
    <div class="content layout layout--col" style="justify-content: space-between">
      <div class="kv">
        <span class="k t-xs t-upper truncate">{% if extension.values.heading != blank %}{{ extension.values.heading | truncate: 18 }}{% else %}{{ board.origin | truncate: 18 }}{% endif %}</span>
        <span class="v t-xs">{{ next.minutes_until | in_words }}</span>
      </div>

      <div class="with-icon" style="gap: 10px">
        <span class="t-bold" style="font-size: 32px; line-height: 1">{{ next.line }}</span>
        <span class="t-mono t-bold" style="font-size: 30px; line-height: 1">
          {% if next.cancelled %}CANC{% else %}{{ next.expected }}{% endif %}
        </span>
      </div>

      <p class="t-xs truncate">
        {{ next.direction }}
        {% if board.departures[1] %} &middot; then {{ board.departures[1].expected }}{% endif %}
      </p>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
