{% comment %} Half width: 400x480. A board down a column. {% endcomment %}

{% assign board = transit %}

<div class="screen">
  <div class="title-bar">
    <div class="title truncate">{% if extension.values.heading != blank %}{{ extension.values.heading | truncate: 16 }}{% else %}{{ board.origin | truncate: 16 }}{% endif %}</div>
    <div class="t-sm">{{ board.destination | truncate: 10 }}</div>
  </div>

  {% if board.empty %}
    <div class="content layout layout--col layout--center" style="gap: 8px">
      <span class="i i-train i-lg"></span>
      <p class="t-md t-bold">No departures</p>
    </div>
  {% else %}
    <div class="content content--tight">
      <div class="list">
        {% for train in board.departures limit: 6 %}
          <div class="list-item">
            <span style="min-width: 0">
              <span class="primary">{{ train.line }}</span>
              <span class="t-xs truncate" style="display: block">{{ train.direction }}</span>
            </span>
            <span style="text-align: right">
              <span class="secondary t-mono t-bold" style="display: block">
                {% if train.cancelled %}CANC{% else %}{{ train.expected }}{% endif %}
              </span>
              {% if train.delayed and train.cancelled == false %}
                <span class="t-xs">+{{ train.delay }}</span>
              {% endif %}
            </span>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  {% if board.alert != blank %}
    <div class="footer-bar">
      <span class="with-icon t-sm"><span class="i i-alert i-xs"></span>{{ board.alert | truncate: 34 }}</span>
    </div>
  {% endif %}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
