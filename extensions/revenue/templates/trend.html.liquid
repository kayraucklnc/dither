{% comment %}
  Figure and trend — the number, with the days behind it.

  Scaled between the quietest and the busiest day rather than from zero. A week
  that runs 2980 to 4260 drawn from zero is seven bars of the same height,
  which says nothing about the week. The floor of 14% keeps the quietest day
  visible, because a bar of no height reads as missing data.
{% endcomment %}

{%- assign money = revenue -%}
{%- assign metric = extension.values.metric | default: "taken" -%}
{%- assign period = extension.values.window | default: "today" -%}
{%- if metric == "taken" -%}
  {%- assign card = money.windows[period] -%}
{%- elsif metric == "next_subscriber" and extension.values.basis == "renewal" -%}
  {%- assign card = money.cards.next_renewal -%}
{%- else -%}
  {%- assign card = money.cards[metric] -%}
{%- endif -%}

{%- assign chart = extension.values.chart | default: "auto" -%}
{%- if chart == "month" -%}
  {%- assign series = money.days -%}
{%- elsif chart == "week" -%}
  {%- assign series = money.week -%}
{%- elsif card.bars == "days" -%}
  {%- assign series = money.days -%}
{%- else -%}
  {%- assign series = money.week -%}
{%- endif -%}

{%- assign box_w = shape.width | at_least: 120 -%}
{%- assign box_h = shape.height | at_least: 60 -%}
{%- assign pad = box_w | divided_by: 16 | at_least: 10 | at_most: 24 -%}

<div class="screen">
  {%- unless card -%}
    <div class="content layout layout--col layout--center" style="gap: 8px; padding: {{ pad }}px">
      <span class="i i-card i-xl"></span>
      <p class="t-md t-bold">Not connected</p>
      <p class="t-sm">Link Stripe under Connections.</p>
    </div>
  {%- else -%}
    {%- assign shown = card.symbol | append: card.figure -%}
    {%- assign chars = shown | size | at_least: 3 -%}
    {%- assign by_width = box_w | minus: pad | minus: pad | times: 100 | divided_by: chars | divided_by: 56 -%}
    {%- comment %} Half the height, because the bars take the other half. {% endcomment -%}
    {%- assign by_height = box_h | times: 24 | divided_by: 100 -%}
    {%- assign figure_size = by_width | at_most: by_height | at_most: 96 | at_least: 15 -%}
    {%- assign caption = extension.values.heading | default: card.caption -%}

    <div class="content layout layout--col" style="gap: {{ pad | divided_by: 2 }}px; padding: {{ pad }}px">
      <div class="stack stack--tight">
        <p class="t-bold t-upper truncate" style="font-size: {{ figure_size | divided_by: 4 | at_least: 10 | at_most: 16 }}px; letter-spacing: 0.06em">
          {{ caption }}
        </p>
        <p class="t-bold" style="font-size: {{ figure_size }}px; line-height: 1; letter-spacing: -0.03em">{{ shown }}</p>
        {% if extension.values.compare != false and card.delta != blank %}
          <p class="with-icon t-bold" style="font-size: {{ figure_size | divided_by: 3 | at_least: 11 | at_most: 18 }}px">
            <span class="i i-trending-{% if card.rising %}up{% else %}down{% endif %} i-sm"></span>
            {{ card.delta }}
          </p>
        {% elsif card.detail != blank %}
          <p class="truncate" style="font-size: {{ figure_size | divided_by: 3 | at_least: 11 | at_most: 18 }}px">{{ card.detail }}</p>
        {% endif %}
      </div>

      {%- comment %} Peak and trough, found in Liquid because the payload is
        shared by every window and cannot be pre-scaled for one. {% endcomment -%}
      {%- assign peak = 0 -%}
      {%- assign trough = 999999999 -%}
      {%- for point in series -%}
        {%- if point.amount > peak %}{% assign peak = point.amount %}{% endif -%}
        {%- if point.amount < trough %}{% assign trough = point.amount %}{% endif -%}
      {%- endfor -%}
      {%- assign span = peak | minus: trough -%}
      {%- if span <= 0 %}{% assign span = 1 %}{% endif -%}

      {%- assign count = series | size -%}
      {%- assign labelled = true -%}
      {%- if count > 10 or box_w < 260 %}{% assign labelled = false %}{% endif -%}

      <div class="fit" style="min-height: {{ box_h | divided_by: 4 }}px">
        <div class="bars" style="gap: {% if count > 12 %}2{% else %}4{% endif %}px">
          {% for point in series %}
            <div class="bar">
              <span class="fill{% unless forloop.last %} fill--hatch{% endunless %}"
                    style="height: {{ point.amount | minus: trough | times: 72 | divided_by: span | plus: 14 }}%"></span>
              {% if labelled %}<span class="tick">{{ point.day }}</span>{% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    {% comment %}
      Where another extension gets to say something on this screen. Glyphs like
      dashboard warning lights, with the loudest one's words beside them when
      the box is wide enough to carry them.
    {% endcomment %}
    {% if notices.size > 0 %}
      <div class="notice-strip" style="padding: 6px {{ pad }}px">
        {% for notice in notices %}
          {% if notice.overflow %}
            <span class="notice notice--more">+{{ notice.overflow }}</span>
          {% else %}
            <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
              <span class="i i-{{ notice.icon }}"></span>
            </span>
          {% endif %}
        {% endfor %}
        {% if shape.wide and notices[0].text != blank %}
          <span class="notice-said">{{ notices[0].text }}</span>
        {% endif %}
      </div>
    {% endif %}
  {%- endunless -%}
</div>
