{% comment %} Quarter: 400x240. Today's number and how it compares. {% endcomment %}

{% assign money = revenue %}

<div class="screen dense">
  <div class="content layout layout--col" style="justify-content: space-between">
    <div class="kv">
      <span class="k t-xs t-upper">{{ extension.values.heading | default: "Revenue" }}</span>
      <span class="v t-xs">{{ money.payments_today }} payments</span>
    </div>

    <div class="stack stack--tight" style="gap: 2px">
      <p class="t-bold" style="font-size: 52px; line-height: 1">{{ money.symbol }}{{ money.today }}</p>
      <p class="with-icon t-sm t-bold">
        <span class="i i-trending-{% if money.change_percent >= 0 %}up{% else %}down{% endif %} i-xs"></span>
        {{ money.change_percent }}%
      </p>
    </div>
  </div>

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
