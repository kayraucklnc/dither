{% comment %} Third height: 800x160. A band across the top of a screen. {% endcomment %}

{% assign money = revenue %}

<div class="screen">
  <div class="content layout layout--row" style="align-items: center; gap: 26px">
    <div>
      <p class="t-xs t-upper">{{ extension.values.heading | default: "Revenue" }}</p>
      <p class="t-bold" style="font-size: 46px; line-height: 1">{{ money.symbol }}{{ money.today }}</p>
    </div>

    <div class="with-icon" style="border-left: var(--rule) solid var(--ink); padding-left: 26px">
      <span class="i i-trending-{% if money.change_percent >= 0 %}up{% else %}down{% endif %} i-md"></span>
      <div>
        <p class="t-lg t-bold">{{ money.change_percent }}%</p>
        <p class="t-xs">on yesterday</p>
      </div>
    </div>

    <div class="facts fit" style="max-width: 300px; margin-left: auto">
      <div class="row">
        <span class="name">Month to date</span>
        <span class="figure">{{ money.symbol }}{{ money.month_to_date }}</span>
      </div>
      <div class="row">
        <span class="name">New customers</span>
        <span class="figure">{{ money.new_customers }}</span>
      </div>
    </div>
  </div>

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
