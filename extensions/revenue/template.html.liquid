{% comment %}
  Board — the whole account at once, for a box that has the room for it.

  The headline the widget was pointed at on the left, everything else the
  account can say on the right, and a month of trading underneath. Declared for
  8x8 upwards, which at 800x480 is 533x320 pixels; below that the rows stop
  being readable and the Ledger or Figure design takes over instead.
{% endcomment %}

{%- assign money = revenue -%}
{%- assign metric = extension.values.metric | default: "taken" -%}
{%- assign period = extension.values.window | default: "today" -%}
{%- if metric == "taken" -%}
  {%- assign card = money.windows[period] -%}
{%- elsif metric == "next_subscriber" and extension.values.basis == "renewal" -%}
  {%- assign card = money.cards.next_renewal -%}
{%- else -%}
  {%- assign card = money.cards[metric] -%}
{%- endif -%}

{%- assign chart = extension.values.chart | default: "auto" -%}
{%- if chart == "week" -%}
  {%- assign series = money.week -%}
{%- elsif chart == "month" -%}
  {%- assign series = money.days -%}
{%- elsif chart == "pace" -%}
  {%- assign series = money.pace.current -%}
{%- elsif chart == "today" -%}
  {%- assign series = "" | split: "" -%}
  {%- for hour in money.hours -%}
    {%- unless hour.ahead %}{% assign series = series | concat: hour %}{% endunless -%}
  {%- endfor -%}
{%- elsif card.bars == "week" -%}
  {%- assign series = money.week -%}
{%- else -%}
  {%- assign series = money.days -%}
{%- endif -%}

{%- assign box_h = shape.height | at_least: 240 -%}

<div class="screen">
  <div class="title-bar" style="padding: {{ box_h | divided_by: 26 | at_least: 10 | at_most: 24 }}px 24px 10px">
    <div class="title">{{ extension.values.heading | default: "Revenue" }}</div>
    <div class="chip self-start">
      <span class="i i-card"></span>{{ money.currency | default: "Stripe" }}
    </div>
  </div>

  {%- unless card -%}
    <div class="content layout layout--col layout--center" style="gap: 8px">
      <span class="i i-card i-xl"></span>
      <p class="t-lg t-bold">Not connected</p>
      <p class="t-sm">Paste a Stripe secret key under Connections and this fills in.</p>
    </div>
  {%- else -%}
    {%- assign digits = card.figure -%}
    {%- if extension.values.compact_figures == false and card.figure_full != blank -%}
      {%- assign digits = card.figure_full -%}
    {%- endif -%}
    {%- assign shown = card.symbol | append: digits -%}
    {%- assign chars = shown | size | at_least: 3 -%}
    {%- comment %} The left column is a little over half the panel. {% endcomment -%}
    {%- assign by_width = shape.width | at_least: 400 | times: 52 | divided_by: 100 | times: 100 | divided_by: chars | divided_by: 56 -%}
    {%- assign figure_size = by_width | at_most: 82 | at_least: 22 -%}

    <div class="content" style="padding: 16px 24px">
      <div class="split-detail">
        <div class="stack fit" style="justify-content: center; gap: 8px">
          <p class="caption t-bold t-upper" style="font-size: 14px; letter-spacing: 0.06em">{{ card.caption }}</p>
          <p class="t-bold" style="font-size: {{ figure_size }}px; line-height: 1; letter-spacing: -0.03em">
            {{ shown }}
          </p>
          {% if extension.values.compare != false and card.delta != blank %}
            <p class="with-icon t-md t-bold">
              <span class="i i-trending-{% if card.rising %}up{% else %}down{% endif %} i-sm"></span>
              {{ card.delta }}
            </p>
          {% endif %}
          {% if card.detail != blank %}<p class="t-sm">{{ card.detail }}</p>{% endif %}
        </div>

        <div class="stack fit" style="justify-content: center">
          <div class="facts">
            <div class="row">
              <span class="name"><span class="i i-refresh i-xs"></span>MRR</span>
              <span class="figure">{{ money.mrr_text }}</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-users i-xs"></span>Subscribers</span>
              <span class="figure">{{ money.cards.subscribers.figure }}</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-users i-xs"></span>Customers</span>
              <span class="figure">{{ money.cards.customers.figure }}</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-hourglass i-xs"></span>Next subscriber</span>
              <span class="figure">{{ money.next_subscriber.in_words }}</span>
            </div>
            <div class="row">
              <span class="name"><span class="i i-chart i-xs"></span>30 days</span>
              <span class="figure">{{ money.windows.last_30d.text }}</span>
            </div>
            {% if shape.rows > 9 %}
              <div class="row">
                <span class="name"><span class="i i-close i-xs"></span>Failed today</span>
                <span class="figure">{{ money.failed_today }}</span>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    {%- comment %} A month of trading, drawn as a line rather than as bars. The
    board has the width for thirty points, and thirty bars two pixels apart is
    a comb - a line is what that many points actually want to be.

    Scaled between the low and the high, never from zero: a month that runs
    2180 to 4680 drawn from zero is a flat line that says nothing about the
    month. Both ends are printed above it, so the scale is never a mystery.
  {% endcomment -%}
  {%- assign peak = 0 -%}
  {%- assign trough = 999999999 -%}
  {%- for point in series -%}
    {%- if point.amount > peak %}{% assign peak = point.amount %}{% endif -%}
    {%- if point.amount < trough %}{% assign trough = point.amount %}{% endif -%}
  {%- endfor -%}
  {%- assign spread = peak | minus: trough -%}
  {%- if spread <= 0 %}{% assign spread = 1 %}{% endif -%}

  {%- assign count = series | size | at_least: 2 -%}
  {%- assign last = count | minus: 1 -%}
  {%- assign stepped = false -%}
  {%- if extension.values.line_style == "steps" %}{% assign stepped = true %}{% endif -%}

  {%- assign points = "" -%}
  {%- for point in series -%}
    {%- assign height = point.amount | minus: trough | times: 250 | divided_by: spread -%}
    {%- assign y = 275 | minus: height -%}
    {%- if stepped -%}
      {%- assign x0 = forloop.index0 | times: 1000 | divided_by: count -%}
      {%- assign x1 = forloop.index | times: 1000 | divided_by: count -%}
      {%- assign points = points | append: x0 | append: "," | append: y | append: " "
                                 | append: x1 | append: "," | append: y | append: " " -%}
    {%- else -%}
      {%- assign x = forloop.index0 | times: 1000 | divided_by: last -%}
      {%- assign points = points | append: x | append: "," | append: y | append: " " -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign filled = true -%}
  {%- if extension.values.line_style == "line" %}{% assign filled = false %}{% endif -%}

  <div style="border-top: var(--rule) solid var(--ink); height: {{ box_h | divided_by: 3 | at_least: 96 | at_most: 150 }}px;
              padding: 8px var(--pad) 10px; display: flex; flex-direction: column; gap: 4px">
    <div style="display: flex; justify-content: space-between; flex: none">
      <span class="t-xs t-bold t-upper">{{ series[0].date }} to today</span>
      <span class="t-xs">high {{ money.symbol }}{{ peak }} &middot; low {{ money.symbol }}{{ trough }}</span>
    </div>
    <div class="fit" style="min-height: 30px">
      <svg viewBox="0 0 1000 300" preserveAspectRatio="none" width="100%" height="100%"
           fill="none" stroke="black" style="display: block">
          {%- comment %} The fill is a ramp from ink at the line to paper at the
            baseline, not a solid mass. The panel is dithered on the way out, so
            the ramp is resolved into a stipple that thins as it falls - which is
            the only kind of tint a 1-bit display has, and the one thing it does
            beautifully. A solid black area is a heavy blot at this size; a
            stipple reads as depth and leaves the gridline under it visible.

            The gradient is in objectBoundingBox units, so it spans the filled
            shape itself - darkest along the highest peak, gone by the axis -
            and the non-uniform stretch of the viewBox does not distort it. {% endcomment -%}
          <defs>
            <linearGradient id="fade" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#000"/>
              <stop offset="0.55" stop-color="#8a8a8a"/>
              <stop offset="1" stop-color="#ffffff"/>
            </linearGradient>
          </defs>
        <line x1="0" y1="275" x2="1000" y2="275" stroke-width="2" vector-effect="non-scaling-stroke"/>
        {% if filled %}
          <polygon points="0,275 {{ points }}1000,275" fill="url(#fade)" stroke="none"/>
        {% endif %}
        <polyline points="{{ points }}" stroke-width="{% if filled %}2{% else %}4{% endif %}"
                  stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
  </div>
  {%- endunless -%}

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    box is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.wide and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
