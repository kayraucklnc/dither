{% comment %} Third height: 800x160. The house on one line. {% endcomment %}

<div class="screen">
  <div class="content layout layout--row" style="align-items: center; gap: 18px">
    <div style="min-width: 130px">
      <p class="t-xs t-upper">{{ extension.values.heading | default: "Home" }}</p>
      <p class="t-lg t-bold">{{ home.on_count }} on</p>
    </div>

    {% for thing in home.entities limit: 5 %}
      <div class="fit layout layout--col" style="align-items: center; gap: 5px; min-width: 0">
        <span class="i i-{{ thing.icon }} i-sm"></span>
        <span class="t-xs truncate" style="max-width: 100%">{{ thing.label }}</span>
        <span class="{% if thing.on %}badge{% else %}chip{% endif %}" style="font-size: 10px; padding: 1px 5px">
          {% if thing.on %}ON{% else %}OFF{% endif %}
        </span>
      </div>
    {% endfor %}
  </div>

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
