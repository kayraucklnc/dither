{% comment %} Half width: 400x480. A list of everything, on or off. {% endcomment %}

<div class="screen">
  <div class="title-bar">
    <div class="title">{{ extension.values.heading | default: "Home" }}</div>
    <div class="t-sm t-bold">{{ home.on_count }} on</div>
  </div>

  <div class="content content--tight">
    <div class="list">
      {% for thing in home.entities limit: 6 %}
        <div class="list-item">
          <span class="with-icon" style="min-width: 0">
            <span class="i i-{{ thing.icon }} i-sm"></span>
            <span style="min-width: 0">
              <span class="primary truncate" style="display: block">{{ thing.label }}</span>
              <span class="t-xs truncate" style="display: block">{{ thing.detail }}</span>
            </span>
          </span>
          <span class="{% if thing.on %}badge{% else %}chip{% endif %}">
            {% if thing.on %}ON{% else %}OFF{% endif %}
          </span>
        </div>
      {% endfor %}
    </div>
  </div>

  {% comment %}
    Where another extension gets to say something on this screen. Glyphs like
    dashboard warning lights, with the loudest one's words beside them when the
    shape is wide enough to carry them.
  {% endcomment %}
  {% if notices.size > 0 %}
    <div class="notice-strip">
      {% for notice in notices %}
        {% if notice.overflow %}
          <span class="notice notice--more">+{{ notice.overflow }}</span>
        {% else %}
          <span class="notice notice--{{ notice.level }}" title="{{ notice.text }}">
            <span class="i i-{{ notice.icon }}"></span>
          </span>
        {% endif %}
      {% endfor %}

      {% if shape.columns >= 6 and notices[0].text != blank %}
        <span class="notice-said">{{ notices[0].text }}</span>
      {% endif %}
    </div>
  {% endif %}
</div>
