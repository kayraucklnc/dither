<%= render "shared/title", text: "Dashboard" %>

<section class="page-dashboard">
  <div class="dash-head">
    <div>
      <h1>Dashboard</h1>
      <p class="sub"><%= device_summary %></p>
    </div>
  </div>

  <div>
    <p class="dash-section-label">Devices</p>

    <% if devices.any? %>
      <ul class="dash-devices">
        <% devices.each do |device| %>
          <li class="dash-device">
            <%= link_to routes.path(:device, id: device.id), class: "dash-device-screen" do %>
              <%= tag.img src: device.current_screen.image_uri,
                          alt: "Current screen on #{device.label}",
                          loading: :lazy %>
            <% end %>

            <div class="dash-device-body">
              <div class="dash-device-title">
                <h3><%= link_to device.label, routes.path(:device, id: device.id) %></h3>
                <span class="dash-status" data-state="<%= device.presence_state %>">
                  <%= device.presence_state %>
                </span>
              </div>

              <p class="dash-device-model">
                <%= device.model.label %> &middot; <%= device.dimensions %>
                <%= " · fw #{device.firmware_version}" unless String(device.firmware_version).empty? %>
              </p>

              <div class="dash-metrics">
                <div class="metric">
                  <span class="k">Last seen</span>
                  <span class="v"><%= device.last_seen_label %></span>
                </div>

                <div class="metric">
                  <span class="k">Next refresh</span>
                  <span class="v"><%= device.next_refresh_label %></span>
                </div>

                <div class="metric">
                  <span class="k"><%= device.charging ? "Charging" : "Battery" %></span>
                  <span class="v"><%= device.battery_percentage.round %>%</span>
                  <span class="dash-bar" data-low="<%= device.battery_low? %>">
                    <%= tag.span style: "inline-size: #{device.battery_percentage.round}%" %>
                  </span>
                </div>

                <div class="metric">
                  <span class="k">Signal</span>
                  <span class="v"><%= device.wifi_percentage.round %>%</span>
                  <span class="dash-bar">
                    <%= tag.span style: "inline-size: #{device.wifi_percentage.round}%" %>
                  </span>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="dash-empty">
        <h3>No devices yet</h3>

        <p>
          Dither is running and ready. Flash a board, then point it at this server &mdash;
          it provisions itself on first contact, no pre-registration needed.
        </p>

        <ol>
          <li>Flash firmware from the <%= link_to "Flash", "/flash" %> page.</li>
          <li>Join the <code>Dither-XXXXXX</code> Wi-Fi hotspot the board creates.</li>
          <li>Under Advanced &rarr; Custom Server, enter <code><%= api_uri %></code>.</li>
        </ol>
      </div>
    <% end %>
  </div>

  <div>
    <p class="dash-section-label">Connection</p>

    <div class="dash-server">
      <div>
        <p class="dash-section-label" style="margin-block-end: 0.4rem">Point your device here</p>

        <div class="dash-endpoint">
          <code id="dash-api-uri"><%= api_uri %></code>
          <button type="button" class="dash-copy" data-copy-target="dash-api-uri">Copy</button>
        </div>
      </div>

      <ul class="dash-addresses">
        <% ip_addresses.each do |ip| %>
          <%= tag.li ip.address_with_kind %>
        <% end %>
      </ul>
    </div>
  </div>

  <div>
    <p class="dash-section-label">Library</p>

    <ul class="dash-library">
      <li><%= link_to routes.path(:scenes) do %><span class="k">Scenes</span><span class="v"><%= scene_count %></span><% end %></li>
      <li><%= link_to routes.path(:extensions) do %><span class="k">Extensions</span><span class="v"><%= extension_count %></span><% end %></li>
      <li><%= link_to routes.path(:models) do %><span class="k">Models</span><span class="v"><%= model_count %></span><% end %></li>
      <li><%= link_to routes.path(:firmwares) do %><span class="k">Firmware</span><span class="v"><%= firmware_count %></span><% end %></li>
      <li><%= link_to routes.path(:users) do %><span class="k">Users</span><span class="v"><%= user_count %></span><% end %></li>
    </ul>
  </div>
</section>
