<ul class="links">
  <li class="item"><%= git_link %></li>
</ul>

<ul class="links">
  <li class="item">
    <%= link_to routes.path(:root),
                class: :link,
                interestfor: "tooltip-action-dither" do %>
      <%= image_tag "logos/mark-ink.svg", class: :icon, width: 30, height: 30, loading: :lazy %>
    <% end %>
  </li>

  <li class="item">
    <%= link_to routes.path(:problem_details),
                class: :link,
                interestfor: "tooltip-action-problem_details" do %>
      <%= image_tag "icons/problem_details.svg", class: :icon, width: 30, height: 30, loading: :lazy %>
    <% end %>
  </li>

  <li class="item">
    <%= link_to "https://github.com/usetrmnl/terminus",
                class: :link,
                interestfor: "tooltip-action-upstream" do %>
      <%= image_tag "icons/git.svg", class: :icon, width: 30, height: 30, loading: :lazy %>
    <% end %>
  </li>
</ul>

<%= scope(:tooltip_action_content, label: "Dither", id: :dither).render %>
<%= scope(:tooltip_action_content, label: "Problem Details", id: :problem_details).render %>
<%= scope(:tooltip_action_content, label: "Upstream (Terminus)", id: :upstream).render %>
