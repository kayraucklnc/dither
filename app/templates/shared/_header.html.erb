<%= link_to routes.path(:root), class: "site-label" do %>
  <%= tag.img src: assets["logos/mark-accent.svg"], alt: "Dither", width: 28, height: 28 %>
  <h1 class=label>dither</h1>
<% end %>

<nav class="site-navigation">
  <input type="checkbox" id="navigation-toggle" class="checkbox">

  <label for="navigation-toggle" class="label">
    <span class="toggle"></span>
  </label>

  <ul class="site-menu">
    <%# Primary: the things you touch while running displays. %>
    <%= scope(:menu_item, label: "Devices", path: routes.path(:devices)).render %>
    <%= scope(:menu_item, label: "Screens", path: routes.path(:screens)).render %>
    <%= scope(:menu_item, label: "Playlists", path: routes.path(:playlists)).render %>
    <%= scope(:menu_item, label: "Designs", path: routes.path(:designs)).render %>
    <%= scope(:menu_item, label: "Extensions", path: routes.path(:extensions)).render %>

    <%# Secondary: set once, rarely revisited. A <details> keeps this JS-free. %>
    <li class="site-menu-more">
      <details class="site-dropdown">
        <summary class="site-icon-button" title="Settings" aria-label="Settings">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.14.31.4.55.71.68H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </summary>

        <div class="site-dropdown-menu">
          <p class="site-dropdown-heading">Hardware</p>
          <%= link_to "Models", routes.path(:models) %>
          <%= link_to "Firmware", routes.path(:firmwares) %>
          <%= link_to "Flash a device", "/flash" %>

          <p class="site-dropdown-heading">Server</p>
          <%= link_to "Users", routes.path(:users) %>
          <%= link_to "Problem details", routes.path(:problem_details) %>
        </div>
      </details>
    </li>

    <li>
      <button type="button" class="site-icon-button site-theme-toggle" aria-label="Toggle theme">◐</button>
    </li>

    <li>
      <a href="/logout" class="site-icon-button" title="Log out" aria-label="Log out">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      </a>
    </li>
  </ul>
</nav>
