<!DOCTYPE html>

<html lang="en">
  <head>
    <script>
      // Applied before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var t = localStorage.getItem("dither:theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

    <title><%= content_for :title %></title>

    <meta charset="utf-8">
    <meta name="description" content="Dither — a self-hosted e-ink display server.">
    <meta name="author" content="Dither">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="view-transition" content="same-origin">
    <%= tag.meta name: "htmx-config", content: htmx_configuration %>

    <%= tag.link title: "Dither: Icon",
                 rel: :icon,
                 href: assets["logos/mark-accent.svg"],
                 type: "image/svg+xml" %>

    <%= tag.link title: "Dither: Apple Icon",
                 rel: "apple-touch-icon",
                 href: assets["logos/apple.png"] %>

    <%= tag.link title: "Dither: Manifest",
                 rel: :manifest,
                 href: assets["manifest.webmanifest"] %>

    <%= tag.link title: "Dither: Stylesheet", rel: :stylesheet, href: assets["app.css"] %>

    <%= javascript_tag "app", defer: true %>
  </head>

  <body class="site-page">
    <header class="site-header">
      <%= render "../shared/header" %>
    </header>

    <main class="site-body">
      <% if flash[:alert] %>
        <div class="site-alert">
          <p><%= flash[:alert] %></p>
        </div>
      <% end %>

      <% if flash[:notice] %>
        <div class="site-notice">
          <p><%= flash[:notice] %></p>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <%= render "../shared/footer" %>
    </footer>
  </body>
</html>
