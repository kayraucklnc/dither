<%= render "shared/title", text: "Scenes" %>

<section class="page-scenes">
  <header class="scenes-head">
    <div>
      <h1>Scenes</h1>
      <p class="sub">A layout with extensions in its slots. Rules decide when a device shows one.</p>
    </div>

    <%= link_to "Compose a scene", routes.path(:scene_new), class: "bit-button-accept" %>
  </header>

  <% if scenes.to_a.any? %>
    <ul class="scene-list">
      <% scenes.each do |scene| %>
        <li class="scene-row">
          <div class="scene-figure"
               style="grid-template-columns: repeat(<%= Dither::Composition::COLUMNS %>, 1fr);
                      grid-template-rows: repeat(<%= Dither::Composition::ROWS %>, 1fr)">
            <% scene.layout_record.slots.each do |slot| %>
              <span data-filled="<%= !scene.assignments[slot.key].nil? %>"
                    style="grid-column: <%= slot.grid_column %>; grid-row: <%= slot.grid_row %>"></span>
            <% end %>
          </div>

          <div class="scene-body">
            <h3><%= scene.label %></h3>
            <p class="scene-summary"><%= scene.summary %></p>
          </div>

          <div class="scene-actions">
            <form method="post" action="<%= routes.path(:scene, id: scene.id) %>">
              <%= tag.input name: :_csrf_token, type: :hidden, value: csrf_token %>
              <input type="hidden" name="_method" value="DELETE">
              <button type="submit" class="bit-button-reject">Delete</button>
            </form>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="scenes-empty">
      <h3>No scenes yet</h3>
      <p>
        Compose one, name it, and it becomes something a device rule can point at.
      </p>
      <%= link_to "Compose a scene", routes.path(:scene_new), class: "bit-button-accept" %>
    </div>
  <% end %>
</section>
