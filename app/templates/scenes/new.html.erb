<%= render "shared/title", text: "Compose" %>

<section class="page-composer"
         id="composer"
         data-preview-path="<%= routes.path(:scene_preview) %>"
         data-model-id="<%= model ? model.id : "" %>">

  <header class="composer-head">
    <div>
      <h1>Compose a scene</h1>
      <p class="sub">
        Drag an extension onto a slot. Slots an extension was not designed for
        will not accept it &mdash; nothing is ever scaled down to fit.
      </p>
    </div>

    <label class="composer-model">
      <span>Panel</span>
      <select id="composer-model">
        <% models.each do |option| %>
          <option value="<%= option.id %>" <%= "selected" if model && option.id == model.id %>>
            <%= option.label %> &middot; <%= option.width %>&times;<%= option.height %>
          </option>
        <% end %>
      </select>
    </label>
  </header>

  <div class="composer-body">
    <%# ---- Layouts ------------------------------------------------------ %>
    <aside class="composer-rail">
      <p class="rail-label">Layout</p>

      <div class="layout-picker" role="radiogroup" aria-label="Scene layout">
        <% layouts.each do |option| %>
          <button type="button"
                  class="layout-option<%= " is-active" if option.id == scene_layout.id %>"
                  role="radio"
                  aria-checked="<%= option.id == scene_layout.id %>"
                  data-layout="<%= option.id %>"
                  title="<%= option.description %>">
            <span class="layout-diagram"
                  style="grid-template-columns: repeat(<%= grid_columns %>, 1fr); grid-template-rows: repeat(<%= grid_rows %>, 1fr)">
              <% option.slots.each do |slot| %>
                <span style="grid-column: <%= slot.grid_column %>; grid-row: <%= slot.grid_row %>"></span>
              <% end %>
            </span>
            <span class="layout-name"><%= option.label %></span>
          </button>
        <% end %>
      </div>
    </aside>

    <%# ---- Panel -------------------------------------------------------- %>
    <div class="composer-stage">
      <div class="panel-frame"
           id="panel"
           style="aspect-ratio: <%= model ? "#{model.width} / #{model.height}" : "5 / 3" %>">

        <img id="panel-image" alt="Rendered scene preview" hidden>

        <div class="panel-slots"
             id="panel-slots"
             style="grid-template-columns: repeat(<%= grid_columns %>, 1fr); grid-template-rows: repeat(<%= grid_rows %>, 1fr)">
          <% scene_layout.slots.each do |slot| %>
            <div class="slot-target"
                 data-slot="<%= slot.key %>"
                 data-shape="<%= slot.shape_id %>"
                 style="grid-column: <%= slot.grid_column %>; grid-row: <%= slot.grid_row %>">
              <span class="slot-shape"><%= slot.shape.label %></span>
              <span class="slot-filled"></span>
              <button type="button" class="slot-clear" title="Clear this slot" hidden>&times;</button>
            </div>
          <% end %>
        </div>

        <div class="panel-status" id="panel-status" hidden></div>
      </div>

      <p class="stage-note" id="stage-note">
        This is the real render &mdash; screenshotted and dithered exactly as the
        panel would receive it.
      </p>
    </div>

    <%# ---- Extensions --------------------------------------------------- %>
    <aside class="composer-rail">
      <p class="rail-label">Extensions</p>

      <% if extensions.to_a.any? %>
        <ul class="palette">
          <% extensions.each do |extension| %>
            <li class="palette-item"
                draggable="true"
                data-extension-id="<%= extension.id %>"
                data-extension-label="<%= extension.label %>"
                data-shapes="<%= extension.shape_ids.join(" ") %>">
              <span class="palette-name"><%= extension.label %></span>
              <span class="palette-shapes">
                <% extension.shapes.each do |shape| %>
                  <span class="shape-chip" title="<%= shape.hint %>"><%= shape.label %></span>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="palette-empty">
          <p>No extensions yet.</p>
          <p><%= link_to "Add one", routes.path(:extension_new) %>, or run
            <code>bin/seed_extensions</code> for the bundled ones.</p>
        </div>
      <% end %>

      <p class="rail-note">
        An extension can only be dropped where it has a design. Add
        <code>templates/&lt;shape&gt;.html.liquid</code> to give it more places
        to live.
      </p>
    </aside>
  </div>
</section>
