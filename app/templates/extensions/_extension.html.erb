<li id="<%= extension.id %>" class="ext-card">
  <%# The render, not the name. An extension is a picture; a list of words
      makes you open each one to find out what it is. %>
  <div class="ext-thumb">
    <% path = extension.thumbnail_path(routes, preview_model) %>
    <% if path %>
      <img src="<%= path %>" alt="<%= extension.label %> rendered full page" loading="lazy">
    <% else %>
      <span class="ext-thumb-none">Add a model to preview</span>
    <% end %>
  </div>

  <div class="ext-body">
    <div class="ext-head">
      <h2 class="ext-name"><%= extension.label %></h2>
      <span class="ext-state" data-state="<%= extension.data_state %>">
        <%= extension.data_description %>
      </span>
    </div>

    <% if extension.description %>
      <p class="ext-description"><%= extension.description %></p>
    <% end %>

    <dl class="ext-facts">
      <div>
        <dt>Source</dt>
        <dd><%= extension.kind_description %></dd>
      </div>
      <div>
        <dt>Refresh</dt>
        <dd><%= extension.schedule_description %></dd>
      </div>
    </dl>

    <%# Where it can be placed is the thing that decides whether it can go in a
        scene at all, so it is on the card rather than two pages away. %>
    <div class="ext-shapes">
      <span class="ext-shapes-label">Fits</span>
      <% extension.shapes.each do |shape| %>
        <span class="ext-shape" title="<%= shape.hint %>"><%= shape.label %></span>
      <% end %>
    </div>

    <div class="ext-actions">
      <%= link_to "Settings", routes.path(:extension_edit, id: extension.id), class: "ext-button" %>
      <%= link_to "Data", routes.path(:extension_sources, extension_id: extension.id), class: "ext-button" %>
      <%= link_to "Duplicate", routes.path(:extension_clone_new, extension_id: extension.id), class: "ext-button" %>
      <%= link_to "Export", routes.path(:extension_export, extension_id: extension.id), class: "ext-button" %>

      <%= render "shared/actions/delete",
                 path: routes.path(:extension, id: extension.id),
                 subject: :extension,
                 target: "closest .ext-card",
                 class: "ext-button ext-button--danger",
                 label: "Remove" %>
    </div>
  </div>
</li>
