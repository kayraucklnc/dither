<%= render "shared/title", text: "Extensions" %>

<section class="page-extensions">
  <header class="ext-header">
    <div>
      <h1>Extensions</h1>
      <p class="sub">
        A block of content with a data source behind it. Drop one into a scene
        slot whose shape it fits.
      </p>
    </div>

    <div class="ext-header-actions">
      <%= render "shared/actions/search", path: routes.path(:extensions), query: %>

      <%= scope(
        :popover_trigger_button,
        icon: :upload,
        tip: :import,
        target: :import,
        width: 25,
        height: 25
      ).render %>

      <%= link_to "New extension", routes.path(:extension_new), class: "bit-button-accept" %>
    </div>
  </header>

  <%= render :import %>

  <%= scope(:popover_default_content, name: :overview, label: "Overview").render do %>
    <p>An extension turns data from somewhere else into part of a screen. Each one declares the shapes it can render in, and can only be placed in a scene slot of a shape it declares.</p>

    <h2 class="label">Search</h2>

    <p>You can fuzzy search by extension label using partial or full label.</p>

    <h2 class="label">Keyboard Shortcuts</h2>

    <ul>
      <li><kbd>CONTROL + n</kbd>: New extension.</li>
      <li><kbd>CONTROL + s</kbd>: Save extension (when within form).</li>
    </ul>
  <% end %>

  <% if extensions.any? %>
    <ul class="ext-list">
      <% extensions.each do |extension| %>
        <%= extension.render :extension, preview_model: %>
      <% end %>
    </ul>
  <% else %>
    <div class="ext-empty">
      <h3>No extensions yet</h3>
      <p>
        Bundled ones live in <code>extensions/</code>. Load them with
        <code>bin/seed_extensions</code>, import a zip, or write a new one.
      </p>
      <%= link_to "New extension", routes.path(:extension_new), class: "bit-button-accept" %>
    </div>
  <% end %>

  <%= scope(:tooltip_action_content, label: "Info").render %>
  <%= scope(:tooltip_action_content, label: "New").render %>
  <%= scope(:tooltip_action_content, label: "Import").render %>
  <%= scope(:tooltip_action_content, label: "Search").render %>
  <%= scope(:tooltip_action_content, label: "Clear").render %>
  <%= scope(:tooltip_action_content, label: "Edit").render %>
  <%= scope(:tooltip_action_content, label: "Clone").render %>
  <%= scope(:tooltip_action_content, label: "Download").render %>
  <%= scope(:tooltip_action_content, label: "Delete").render %>
</section>

