<!DOCTYPE html>

<html lang="en">
  <head>
    <script>
      // Applied before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          var t = localStorage.getItem("dither:theme");
          if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

    <% page_title = content_for(:title).to_s %>
    <title><%= page_title.empty? ? "Dither" : page_title %></title>

    <meta charset="utf-8">
    <meta name="description" content="Dither — a self-hosted e-ink display server.">
    <meta name="author" content="Dither">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="htmx-config" content='{"selfRequestsOnly":true}'>
    <meta name="view-transition" content="same-origin">

    <%= tag.link title: "Dither: Icon",
                 rel: :icon,
                 href: main_assets["logos/mark-accent.svg"],
                 type: "image/svg+xml" %>

    <%= tag.link title: "Dither: Apple Icon",
                 rel: "apple-touch-icon",
                 href: main_assets["logos/apple.png"] %>

    <%= tag.link title: "Dither: Manifest",
                 rel: :manifest,
                 href: main_assets["manifest.webmanifest"] %>

    <%= tag.link title: "Dither: Stylesheet",
                 rel: :stylesheet,
                 href: assets["app.css"] %>

    <%= javascript_tag "app.js" %>
  </head>

  <body class="site-authentication">
    <div class="auth-stage">
      <aside class="auth-art" aria-hidden="true">
        <canvas class="site-dither"></canvas>

        <div class="auth-art-copy">
          <p class="auth-art-eyebrow">Self-hosted e-ink</p>
          <p class="auth-art-headline">One bit per pixel.<br>Every pixel yours.</p>
        </div>
      </aside>

      <main class="auth-panel">
        <div class="auth-card">
          <div class="auth-brand">
            <%= tag.img src: main_assets["logos/mark-accent.svg"],
                        alt: "",
                        width: 28,
                        height: 28,
                        class: "auth-brand-mark" %>
            <span class="auth-brand-label">dither</span>

            <button type="button" class="site-theme-toggle" aria-label="Theme">◐</button>
          </div>

          <% if flash[:alert] %>
            <div class="site-alert" role="alert">
              <p><%= flash[:alert] %></p>
            </div>
          <% end %>

          <% if flash[:notice] %>
            <div class="site-notice" role="status">
              <p><%= flash[:notice] %></p>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
