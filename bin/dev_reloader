#! /usr/bin/env ruby
# frozen_string_literal: true

# Restarts the web server when Ruby sources change.
#
# Hanami has no reloader in this app, so a change under app/ used to mean
# running `bin/dev restart web` by hand. Puma's tmp_restart plugin is already
# enabled in config/puma.rb, which restarts the server whenever tmp/restart.txt
# is touched - this just watches for changes and does the touching.
#
# It polls rather than using inotify on purpose: filesystem events do not cross
# the macOS to Linux container boundary reliably, and a once-a-second stat of a
# few hundred files costs nothing next to being unsure whether your edit landed.
#
# Templates and assets are not watched: ERB is re-read per render and the assets
# service rebuilds CSS and JS itself, so both are already live without a restart.

require "pathname"

ROOT = Pathname(__dir__).join("..").expand_path
PATTERN = "{app,lib,config,slices}/**/*.rb"
RESTART_FILE = ROOT.join "tmp/restart.txt"
INTERVAL = Float ENV.fetch("RELOAD_INTERVAL", "1")

def snapshot
  Dir.chdir(ROOT) { Dir.glob(PATTERN).to_h { |path| [path, File.mtime(path)] } }
rescue Errno::ENOENT
  # A file vanished mid-scan (editor swap file, git checkout). Next tick is fine.
  {}
end

def describe previous, current
  changed = current.reject { |path, time| previous[path] == time }.keys
  removed = previous.keys - current.keys
  (changed + removed).sort
end

RESTART_FILE.dirname.mkpath
previous = snapshot

puts "Watching #{previous.size} Ruby files. Editing any of them restarts the server."
$stdout.flush

loop do
  sleep INTERVAL
  current = snapshot
  next if current.empty? || current == previous

  paths = describe previous, current
  previous = current

  next if paths.empty?

  RESTART_FILE.write Time.now.to_s
  puts "Restarting: #{paths.first(4).join ", "}#{" and #{paths.size - 4} more" if paths.size > 4}"
  $stdout.flush
end
