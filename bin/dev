#! /usr/bin/env bash
#
# Development stack wrapper.
#
# Prefer the Makefile — `make help` — which wraps the common calls. This script
# is the implementation, and still takes anything docker compose does.
#
#   bin/dev up                     start (source-mounted, assets watching)
#   bin/dev down                   stop
#   bin/dev url                    print this worktree's URL
#   bin/dev account <email> <pw>   register an account on this worktree
#   bin/dev logs assets            follow the asset watcher
#   bin/dev restart web            pick up Ruby changes under app/
#   bin/dev <anything>             passed straight through to docker compose
#
# Every git worktree gets its own Compose project and its own port trio, so the
# stacks run side by side and you can compare two branches in two browser tabs.
# The assignment is computed once and cached in .context/dev.env; delete that
# file to have it recomputed.

set -o nounset
set -o errexit
set -o pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

ROOT="$PWD"
SLUG="$(basename "$ROOT" | tr '[:upper:]' '[:lower:]' | tr -c '[:alnum:]\n' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')"
CACHE=".context/dev.env"

# Base ports, matching the committed .env defaults.
BASE_HANAMI=2300
BASE_DATABASE=5433
BASE_KEYVALUE=6379

port_free() {
  ! nc -z 127.0.0.1 "$1" >/dev/null 2>&1
}

# First offset (in steps of 10) whose whole trio is unclaimed by another
# worktree and unused on the host.
allocate_offset() {
  local claimed=() other offset

  while IFS= read -r other; do
    [ "$other" = "$ROOT" ] && continue
    [ -f "$other/$CACHE" ] || continue
    claimed+=("$(sed -n 's/^DEV_PORT_OFFSET=//p' "$other/$CACHE")")
  done < <(git worktree list --porcelain | sed -n 's/^worktree //p')

  for offset in $(seq 0 10 490); do
    case " ${claimed[*]-} " in *" $offset "*) continue ;; esac

    if port_free $((BASE_HANAMI + offset)) &&
       port_free $((BASE_DATABASE + offset)) &&
       port_free $((BASE_KEYVALUE + offset)); then
      printf '%s' "$offset"
      return 0
    fi
  done

  echo "bin/dev: no free port trio between offsets 0 and 490." >&2
  return 1
}

if [ -f "$CACHE" ]; then
  # shellcheck disable=SC1090
  . "$CACHE"
else
  mkdir -p "$(dirname "$CACHE")"
  DEV_PORT_OFFSET="$(allocate_offset)"
  printf 'DEV_PORT_OFFSET=%s\n' "$DEV_PORT_OFFSET" > "$CACHE"
fi

# Shell environment beats .env in Compose's interpolation precedence, so these
# override the committed defaults without the worktree needing its own .env.
export COMPOSE_PROJECT_NAME="dither-${SLUG}"
export HANAMI_PORT=$((BASE_HANAMI + DEV_PORT_OFFSET))
export DATABASE_PORT=$((BASE_DATABASE + DEV_PORT_OFFSET))
export KEYVALUE_PORT=$((BASE_KEYVALUE + DEV_PORT_OFFSET))

# Ports do not scope cookies. Without a per-project name every stack on
# localhost fights over one session cookie, and logging into this one gets you
# a CSRF InvalidToken as soon as another worktree overwrites it.
export SESSION_COOKIE_KEY="${COMPOSE_PROJECT_NAME}.session"
export REMEMBER_COOKIE_KEY="${COMPOSE_PROJECT_NAME}.remember"

FILES=(--file compose.yml --file compose.dev.yml)

compose() {
  docker compose "${FILES[@]}" "$@"
}

# Each worktree owns its Compose project, so it also owns an empty database
# volume the first time it starts. The dev overlay sets APP_SETUP=false (the
# assets watcher compiles instead of the entrypoint), which means nothing else
# would ever run the migrations and web would boot into "relation does not
# exist".
prepare_database() {
  compose up --detach --wait database >/dev/null

  local existing
  existing="$(compose exec -T database sh -c \
    "psql --username \"\$POSTGRES_USER\" --dbname \"\$POSTGRES_DB\" \
          --port ${DATABASE_PORT} --tuples-only --no-align \
          --command \"select to_regclass('public.account')\"" 2>/dev/null | tr -d '[:space:]')"

  [ -n "$existing" ] && return 0

  echo "==> Preparing a fresh database for ${COMPOSE_PROJECT_NAME}."
  compose run --rm --no-deps web bundle exec hanami db prepare
}

# Registers an account through the running server rather than by inserting rows,
# so Rodauth owns the password hashing and the account/membership records. Every
# worktree has its own database, so every worktree needs this once.
create_account() {
  local email="$1" password="$2" name="$3"
  local base="http://localhost:${HANAMI_PORT}"
  local jar token status

  jar="$(mktemp)"
  trap 'rm -f "$jar"' RETURN

  token="$(curl --silent --cookie-jar "$jar" "$base/register" |
           grep --only-matching 'name="_csrf" value="[^"]*"' |
           sed 's/.*value="//; s/"$//')"

  if [ -z "$token" ]; then
    echo "bin/dev: ${base} is not answering. Start it with 'bin/dev up' first." >&2
    return 1
  fi

  status="$(curl --silent --cookie "$jar" --output /dev/null --write-out '%{http_code}' \
                 --request POST \
                 --data-urlencode "_csrf=${token}" \
                 --data-urlencode "name=${name}" \
                 --data-urlencode "login=${email}" \
                 --data-urlencode "login-confirm=${email}" \
                 --data-urlencode "password=${password}" \
                 "$base/register")"

  # Rodauth redirects on success and re-renders the form on any rejection.
  if [ "$status" != "302" ]; then
    echo "bin/dev: registration was rejected (HTTP ${status})." >&2
    echo "         The account may already exist, or the password may be too common." >&2
    return 1
  fi

  # Only the first account on a server is verified automatically; later ones are
  # created but cannot sign in until an administrator verifies them. Both cases
  # redirect, so ask whether the new session can actually reach the dashboard.
  if [ "$(curl --silent --cookie "$jar" --output /dev/null --write-out '%{http_code}' "$base/")" = "200" ]; then
    echo "==> Created ${email} on ${COMPOSE_PROJECT_NAME}. Sign in at ${base}/login"
    return 0
  fi

  echo "==> Created ${email}, but it is unverified and cannot sign in yet." >&2
  echo "    Only the first account on a server is verified automatically." >&2
  return 1
}

case "${1:-}" in
  up)
    shift
    prepare_database
    compose up --detach "$@"
    echo
    echo "  ${COMPOSE_PROJECT_NAME}  ->  http://localhost:${HANAMI_PORT}"
    ;;
  url)
    echo "http://localhost:${HANAMI_PORT}"
    ;;
  open)
    open "http://localhost:${HANAMI_PORT}"
    ;;
  account)
    shift
    if [ $# -lt 2 ]; then
      echo "usage: bin/dev account <email> <password> [name]" >&2
      exit 1
    fi
    create_account "$1" "$2" "${3:-Developer}"
    ;;
  *)
    exec docker compose "${FILES[@]}" "$@"
    ;;
esac
