#! /usr/bin/env ruby
# frozen_string_literal: true

# Loads bundled extensions from extensions/*/ into the database.
#
# Each directory holds configuration.yml + template.html.liquid, plus an
# optional templates/<shape>.html.liquid per extra layout variant. That is the
# same set the zip importer accepts - so a bundled extension is also a valid
# export, and anything authored here can be handed to someone else unchanged.
#
#   bin/seed_extensions                 load anything not already present
#   bin/seed_extensions --force         replace existing ones
#   bin/seed_extensions <name> [<name>] load only these
#
# See extensions/README.md for the authoring guide.

require "bundler/setup"
require "yaml"
require "hanami/prepare"

Hanami.app.prepare

force = ARGV.delete("--force")
wanted = ARGV.reject { |argument| argument.start_with?("--") }

root = Hanami.app.root.join("extensions")
repository = Hanami.app["repositories.extension"]
extension_creator = Hanami.app["aspects.extensions.importers.local.creators.extension"]
exchange_creator = Hanami.app["aspects.extensions.importers.local.creators.exchange"]

directories = root.children.select(&:directory?).reject { |path| path.basename.to_s.start_with?("_") }
directories.select! { |path| wanted.include?(path.basename.to_s) } if wanted.any?

abort "No bundled extensions found in #{root}." if directories.empty?

loaded = 0
skipped = 0
failed = 0

directories.sort.each do |directory|
  name = directory.basename.to_s
  configuration_path = directory.join("configuration.yml")
  template_path = directory.join("template.html.liquid")

  unless configuration_path.exist? && template_path.exist?
    warn "  ERROR   #{name}: needs configuration.yml and template.html.liquid"
    failed += 1
    next
  end

  # Variants are declared by writing them: every templates/<shape>.html.liquid
  # is a shape this extension may occupy, and nothing else is.
  variants = Dither::Aspects::Extensions::Variants.call(
    directory.glob("templates/*.html.liquid")
             .to_h { |path| [path.relative_path_from(directory).to_s, path.read] }
  )

  if variants.problems.any?
    variants.problems.each { |problem| warn "  ERROR   #{name}: #{problem}" }
    failed += 1
    next
  end

  attributes = YAML.load_file(configuration_path, aliases: true)
  attributes["template"] = template_path.read
  attributes["variants"] = variants.variants

  existing = repository.find_by name: attributes.fetch("name")

  if existing && !force
    puts "  skip    #{name} (already installed)"
    skipped += 1
    next
  end

  # Replace rather than patch: exchanges cascade on delete, so this keeps the
  # database matching the files exactly instead of accumulating stale rows.
  repository.delete existing.id if existing

  exchanges = attributes.delete("exchanges") || []

  result = extension_creator.call(attributes)

  if result.failure?
    warn "  ERROR   #{name}: #{result.failure}"
    failed += 1
    next
  end

  extension = result.value!
  exchanges.each { |exchange| exchange_creator.call exchange.merge("extension_id" => extension.id) }

  shapes = ["full", *variants.variants.keys]
  detail = "#{exchanges.size} exchange#{"s" unless exchanges.size == 1}, " \
           "#{shapes.size} shape#{"s" unless shapes.size == 1}: #{shapes.join ", "}"

  puts "  #{existing ? "replace" : "install"} #{name} (#{detail})"
  loaded += 1
end

puts "\nInstalled #{loaded}, skipped #{skipped}, failed #{failed}."
exit(failed.zero? ? 0 : 1)
