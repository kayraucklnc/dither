#! /usr/bin/env ruby
# frozen_string_literal: true

# Seeds the example design library.
#
# Designs are plain HTML using the Dither screen framework (see
# app/templates/layouts/_screen_framework.html.erb). They render at the target
# model's resolution, get screenshotted by Chromium and dithered to 1-bit.
#
# Content here is deliberately static and realistic rather than Liquid-driven:
# an example should look right the moment you open it, and show you the markup
# to copy. Swap values for {{ liquid }} once an extension is feeding it.
#
#   bin/seed_designs            seed anything missing
#   bin/seed_designs --force    overwrite existing examples

require "bundler/setup"
require "refinements/hash"
require "hanami/prepare"

Hanami.app.prepare

force = ARGV.include?("--force")
templates = Hanami.app["repositories.screen_template"]
models = Hanami.app["repositories.model"]
upserter = Hanami.app["aspects.screens.upserter"]

model = models.all.find { |candidate| candidate.name == "waveshare_7_5_bw" } ||
        models.all.find { |candidate| candidate.width == 800 && candidate.height == 480 }

abort "No 800x480 model found; cannot seed." unless model

DESIGNS = [
  {
    name: "example_clock",
    label: "Clock",
    content: <<~HTML
      <div class="screen">
        <div class="content layout layout--col layout--center">
          <div class="t-center">
            <div class="t-xxl t-bold t-mono" style="font-size:150px;line-height:1">09:41</div>
            <div class="t-lg t-upper" style="margin-top:8px">Thursday, 27 August</div>
          </div>
        </div>
        <div class="footer-bar">
          <span>Week 35</span>
          <span>Sunset 20:04</span>
        </div>
      </div>
    HTML
  },
  {
    name: "example_departures",
    label: "Departures",
    content: <<~HTML
      <div class="screen">
        <div class="title-bar">
          <div class="title">Departures</div>
          <div class="meta">Kadıköy · 08:41</div>
        </div>
        <div class="content">
          <div class="cols cols--sidebar">
            <div class="list fit">
              <div class="list-item"><span class="primary truncate">M4 Sabiha Gökçen</span><span class="secondary t-mono t-bold">2 min</span></div>
              <div class="list-item"><span class="primary truncate">Ferry — Eminönü</span><span class="secondary t-mono t-bold">6 min</span></div>
              <div class="list-item"><span class="primary truncate">Metrobus 34AS</span><span class="secondary t-mono t-bold">11 min</span></div>
              <div class="list-item"><span class="primary truncate">M4 Tavşantepe</span><span class="secondary t-mono t-bold">14 min</span></div>
              <div class="list-item"><span class="primary truncate">Bus 19T Levent</span><span class="secondary t-mono t-bold">18 min</span></div>
            </div>
            <div class="stack">
              <div class="box stat"><span class="value">2</span><span class="label">Next</span></div>
              <div class="stack stack--tight">
                <div class="kv"><span class="k">Line</span><span class="v">M4</span></div>
                <hr class="rule">
                <div class="kv"><span class="k">Platform</span><span class="v">2</span></div>
              </div>
              <span class="badge">live</span>
            </div>
          </div>
        </div>
        <div class="footer-bar"><span>Updated 08:41</span><span class="t-mono">dither</span></div>
      </div>
    HTML
  },
  {
    name: "example_agenda",
    label: "Agenda",
    content: <<~HTML
      <div class="screen">
        <div class="title-bar">
          <div class="title">Today</div>
          <div class="meta">Thu 27 Aug · 4 events</div>
        </div>
        <div class="content">
          <div class="list">
            <div class="list-item">
              <span class="primary truncate">Standup</span>
              <span class="secondary t-mono">09:30 – 09:45</span>
            </div>
            <div class="list-item">
              <span class="primary truncate">Design review — e-ink framework</span>
              <span class="secondary t-mono">11:00 – 12:00</span>
            </div>
            <div class="list-item">
              <span class="primary truncate">Lunch with Deniz</span>
              <span class="secondary t-mono">13:00 – 14:00</span>
            </div>
            <div class="list-item">
              <span class="primary truncate">Focus block: connectors</span>
              <span class="secondary t-mono">15:00 – 17:30</span>
            </div>
          </div>
        </div>
        <div class="footer-bar"><span>Next: Standup in 12 min</span><span class="badge">calendar</span></div>
      </div>
    HTML
  },
  {
    name: "example_weather",
    label: "Weather",
    content: <<~HTML
      <div class="screen">
        <div class="title-bar">
          <div class="title">İstanbul</div>
          <div class="meta">Updated 08:40</div>
        </div>
        <div class="content">
          <div class="cols cols--2 divide-x">
            <div class="stack layout--center">
              <div class="stat t-center">
                <span class="value" style="font-size:110px">24°</span>
                <span class="label">Partly cloudy</span>
              </div>
            </div>
            <div class="stack stack--tight">
              <div class="kv"><span class="k">Feels like</span><span class="v">26°</span></div>
              <hr class="rule">
              <div class="kv"><span class="k">High / Low</span><span class="v">29° / 19°</span></div>
              <hr class="rule">
              <div class="kv"><span class="k">Humidity</span><span class="v">61%</span></div>
              <hr class="rule">
              <div class="kv"><span class="k">Wind</span><span class="v">12 km/h NE</span></div>
              <hr class="rule">
              <div class="kv"><span class="k">Rain</span><span class="v">10%</span></div>
            </div>
          </div>
        </div>
        <div class="footer-bar"><span>Sunrise 06:22</span><span>Sunset 20:04</span></div>
      </div>
    HTML
  },
  {
    name: "example_stats",
    label: "Stats",
    content: <<~HTML
      <div class="screen">
        <div class="title-bar">
          <div class="title">This week</div>
          <div class="meta">27 Aug</div>
        </div>
        <div class="content">
          <div class="cols cols--3" style="height:auto">
            <div class="box stat"><span class="value value--sm">1,284</span><span class="label">Visitors</span></div>
            <div class="box stat"><span class="value value--sm">96%</span><span class="label">Uptime</span></div>
            <div class="box stat"><span class="value value--sm">18</span><span class="label">Deploys</span></div>
          </div>
          <div class="stack stack--tight" style="margin-top:20px">
            <div class="kv"><span class="k">Slowest endpoint</span><span class="v t-mono">/api/display 412 ms</span></div>
            <hr class="rule">
            <div class="kv"><span class="k">Errors (24h)</span><span class="v t-mono">3</span></div>
            <hr class="rule">
            <div class="kv"><span class="k">Queue depth</span><span class="v t-mono">0</span></div>
          </div>
        </div>
        <div class="footer-bar"><span>dither</span><span>auto-refresh 15 min</span></div>
      </div>
    HTML
  }
].freeze

created = 0
skipped = 0

DESIGNS.each do |design|
  existing = templates.find_by name: design[:name]

  if existing && !force
    puts "  skip    #{design[:name]} (exists)"
    skipped += 1
    next
  end

  record = if existing
             templates.update existing.id, **design
           else
             templates.create design
           end

  upserter.call(model_id: model.id, **record.screen_attributes)
  puts "  #{existing ? "update " : "create "} #{design[:name]}"
  created += 1
end

puts "\nSeeded #{created}, skipped #{skipped}. Model: #{model.label} (#{model.width}x#{model.height})."
